---
import ShareButtons from "~/components/ShareButtons.astro";
import {
  discordUrl,
  doujinShopLinks,
  patreonUrl,
  pixivUrl,
  profileNames,
  xAccountNames,
  xAccountUrls,
} from "~/constants/social";
import { ui } from "~/i18n/ui";

export interface Props {
  lang: "ja" | "en";
  profileDescription: string;
  pageUrl: string;
}

const { lang, profileDescription, pageUrl } = Astro.props;
const t = ui[lang];

const profileName = profileNames[lang];
const xNames = xAccountNames[lang];

const snsLinks = [
  {
    href: xAccountUrls[0],
    icon: "/images/icon_x1.jpg",
    title: `X · ${xNames[0]}`,
    sub: `@${new URL(xAccountUrls[0]).pathname.replace(/\//g, "")}`,
  },
  {
    href: xAccountUrls[3],
    icon: "/images/icon_x4.jpg",
    title: `X · ${xNames[3]}`,
    sub: `@${new URL(xAccountUrls[3]).pathname.replace(/\//g, "")}`,
  },
];
---
<div class="profile-page">
  <section class="hero-card">
    <div class="hero-avatar-ring">
      <img src="/images/icon.png" alt={lang === "ja" ? "プロフィールアイコン" : "Profile icon"} class="hero-avatar" />
    </div>
    <div class="hero-body">
      <h1>{profileName}</h1>
      <p class="hero-bio">{profileDescription}</p>
      <div class="hero-actions">
        <a href={discordUrl} target="_blank" rel="noopener noreferrer" class="discord-pill" aria-label="Discord">
          <img src="/Discord_Symbol_Color/Discord-Symbol-Blurple.svg" alt="" />
          <span>Discord</span>
        </a>
        <div class="hero-share">
          <ShareButtons lang={lang} url={pageUrl} text={t["profile.shareText"]} />
        </div>
      </div>
    </div>
  </section>

  <section class="link-section">
    <h2>{t["profile.snsHeading"]}</h2>
    <div class="link-list">
      {snsLinks.map((link) => (
        <a class="link-row" href={link.href} target="_blank" rel="noopener noreferrer">
          <span class="link-icon"><img src={link.icon} alt="" /></span>
          <span class="link-text">
            <span class="link-title">{link.title}</span>
            <span class="link-sub">{link.sub}</span>
          </span>
          <i class="ti ti-arrow-up-right link-arrow" aria-hidden="true"></i>
        </a>
      ))}
      <a class="link-row" href={pixivUrl} target="_blank" rel="noopener noreferrer">
        <span class="link-icon link-badge" style={`--badge-color: #0096fa`}>P</span>
        <span class="link-text">
          <span class="link-title">pixiv</span>
          <span class="link-sub">{lang === "ja" ? "イラスト投稿" : "Illustrations"}</span>
        </span>
        <i class="ti ti-arrow-up-right link-arrow" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <section class="link-section">
    <h2>{t["profile.shopHeading"]}</h2>
    <div class="link-list">
      {doujinShopLinks.map((shop) => (
        shop.url ? (
          <a class="link-row" href={shop.url} target="_blank" rel="noopener noreferrer">
            <span class="link-icon link-badge" style={`--badge-color: ${shop.color}`}>{shop.abbr}</span>
            <span class="link-text">
              <span class="link-title">{shop.name[lang]}</span>
            </span>
            <i class="ti ti-arrow-up-right link-arrow" aria-hidden="true"></i>
          </a>
        ) : (
          <span class="link-row link-row-disabled" aria-disabled="true">
            <span class="link-icon link-badge link-badge-muted" style={`--badge-color: ${shop.color}`}>{shop.abbr}</span>
            <span class="link-text">
              <span class="link-title">{shop.name[lang]}</span>
            </span>
            <span class="soon-badge">{t["profile.comingSoon"]}</span>
          </span>
        )
      ))}
    </div>
  </section>

  <section class="membership-card">
    <h2>{t["profile.fansite"]}</h2>
    <p class="membership-lead">{t["profile.membershipLead"]}</p>
    <a
      href={patreonUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="membership-banner-link"
      data-ga-event="membership_cta_click"
      data-ga-source="profile_banner"
    >
      <img src="/images/patreon-banner.png" alt="Patreon" />
    </a>
    <a
      href={patreonUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="membership-cta"
      data-ga-event="membership_cta_click"
      data-ga-source="profile_cta"
    >
      {t["profile.membershipCta"]}
      <i class="ti ti-arrow-right" aria-hidden="true"></i>
    </a>
    <a href={lang === "ja" ? "/membership" : "/en/membership"} class="membership-more-link">
      {t["artwork.membershipMoreLink"]}
    </a>
  </section>
</div>

<style is:inline>
  .profile-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 1.4rem;
    display: grid;
    gap: 1.6rem;
  }

  .hero-card,
  .link-section,
  .membership-card {
    min-width: 0;
    border: 0.5px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
  }

  .hero-card {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.1rem;
    padding: 2.2rem 1.6rem;
    background: linear-gradient(160deg, var(--accent-soft), var(--bg-elevated) 65%);
  }

  .hero-avatar-ring {
    padding: 4px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-strong), var(--accent));
  }

  .hero-avatar {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--bg-elevated);
    display: block;
  }

  .hero-body h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.6rem, 5vw, 2.1rem);
    color: var(--text-primary);
  }

  .hero-bio {
    margin: 0 auto;
    max-width: 32rem;
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text-secondary);
  }

  .hero-actions {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    margin-top: 0.4rem;
  }

  .discord-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 0.5px solid var(--border-strong);
    background: var(--bg-elevated-2);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .discord-pill:hover,
  .discord-pill:focus-visible {
    border-color: var(--accent-strong);
    transform: translateY(-1px);
  }

  .discord-pill img {
    width: 20px;
    height: 20px;
  }

  .link-section,
  .membership-card {
    padding: 1.3rem 1.3rem 1.4rem;
  }

  .link-section h2,
  .membership-card h2 {
    margin: 0 0 0.9rem;
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-primary);
  }

  .link-list {
    display: grid;
    gap: 0.6rem;
  }

  .link-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-md);
    border: 0.5px solid var(--border-subtle);
    background: var(--bg-elevated-2);
    text-decoration: none;
    color: var(--text-primary);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .link-row:not(.link-row-disabled):hover,
  .link-row:not(.link-row-disabled):focus-visible {
    border-color: var(--accent-strong);
    transform: translateX(2px);
  }

  .link-row-disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .link-icon {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .link-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .link-badge {
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: -0.01em;
    color: var(--badge-color);
    background: color-mix(in srgb, var(--badge-color) 18%, transparent);
    border: 0.5px solid color-mix(in srgb, var(--badge-color) 55%, transparent);
  }

  .link-badge-muted {
    filter: saturate(0.4);
  }

  .link-text {
    flex: 1 1 auto;
    display: grid;
    min-width: 0;
    line-height: 1.35;
  }

  .link-title {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .link-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .link-arrow {
    flex: 0 0 auto;
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .soon-badge {
    flex: 0 0 auto;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--text-muted);
    border: 0.5px solid var(--border-strong);
  }

  .membership-card {
    background: var(--accent-soft);
    border-color: var(--accent);
    display: grid;
    gap: 0.9rem;
  }

  .membership-lead {
    margin: -0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .membership-banner-link img {
    width: 100%;
    border-radius: var(--radius-md);
    transition: transform 0.3s ease;
  }

  .membership-banner-link:hover img,
  .membership-banner-link:focus-visible img {
    transform: scale(1.01);
  }

  .membership-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 1.2rem;
    border-radius: 999px;
    background: var(--accent-strong);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .membership-cta:hover,
  .membership-cta:focus-visible {
    transform: translateY(-1px);
  }

  .membership-more-link {
    display: inline-flex;
    justify-self: center;
    color: var(--text-secondary);
    font-size: 0.85rem;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    transition: color 0.2s ease;
  }

  .membership-more-link:hover,
  .membership-more-link:focus-visible {
    color: var(--text-primary);
  }

  @media (width <= 560px) {
    .profile-page {
      padding: 1rem;
      gap: 1.1rem;
    }

    .hero-card {
      padding: 1.6rem 1.2rem;
    }

    .hero-avatar {
      width: 108px;
      height: 108px;
    }

    .link-section,
    .membership-card {
      padding: 1.1rem;
    }
  }
</style>
