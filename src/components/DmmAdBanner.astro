---
// DMMアフィリエイトウィジェット広告。ローカル環境では登録ドメイン外のため空枠のまま表示される。
export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<div class:list={["dmm-ad-banner", className]}>
  <ins class="dmm-widget-placement" data-id="b33eebe5fdfc5abc20b18d701b4014c6" style="background:transparent"></ins>
</div>
<script is:inline src="https://widget-view.dmm.co.jp/js/placement.js" class="dmm-widget-scripts" data-id="b33eebe5fdfc5abc20b18d701b4014c6"></script>

<style is:global>
  .dmm-ad-banner {
    display: flex;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--radius-md);
  }
</style>
