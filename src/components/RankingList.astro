---
export interface RankingEntry {
  slug: string;
  title: string;
  thumb: string;
  href: string;
}

export interface Props {
  // 同一ページに複数配置される可能性はないが、JSON埋め込みとwidget側の紐付けに使う
  id: string;
  emptyText: string;
  rankingIndex: RankingEntry[];
  // ワーカーAPIへのlimitパラメータ。サイドバーでは上位10件、専用ページでは上限50件まで
  limit?: number;
  seeMoreHref?: string;
  seeMoreLabel?: string;
}

const {
  id,
  emptyText,
  rankingIndex,
  limit = 10,
  seeMoreHref,
  seeMoreLabel,
} = Astro.props;
---
<div class="ranking-widget" data-widget-id={id} data-limit={limit}>
  <div class="ranking-list" data-empty-text={emptyText}></div>
  {seeMoreHref && seeMoreLabel && (
    <a class="ranking-see-more" href={seeMoreHref}>
      {seeMoreLabel}
      <i class="ti ti-arrow-right" aria-hidden="true"></i>
    </a>
  )}
</div>
<script is:inline type="application/json" class="ranking-widget-index" data-widget-id={id} set:html={JSON.stringify(rankingIndex)} />

<script>
  interface RankingEntry {
    slug: string;
    title: string;
    thumb: string;
    href: string;
  }
  type RankingRow = { slug: string; count: number };

  const API_BASE = import.meta.env.PUBLIC_API_BASE as string | undefined;
  // Workerが無料枠上限やデプロイ直後の一時停止などで応答しない場合のフォールバック先。
  // ビルド時にscripts/fetch-ranking-snapshot.mjsが生成する静的コピー(同一オリジン配信)
  const SNAPSHOT_URL = "/ranking-snapshot.json";

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function initRankingWidget(widget: HTMLElement) {
    const widgetId = widget.dataset.widgetId;
    const list = widget.querySelector<HTMLElement>(".ranking-list");
    const limit = Number(widget.dataset.limit ?? 10);
    const indexScript = document.querySelector<HTMLScriptElement>(
      `.ranking-widget-index[data-widget-id="${widgetId}"]`,
    );
    const rankingIndex: RankingEntry[] = indexScript
      ? JSON.parse(indexScript.textContent ?? "[]")
      : [];
    const rankingIndexBySlug = new Map(rankingIndex.map((entry) => [entry.slug, entry]));

    // ウィジェット（見出しを含む場合はその親のsidebar-sectionまで）を、データが取れるまで隠す
    const hideTarget = widget.closest(".sidebar-section") ?? widget;
    hideTarget.setAttribute("hidden", "true");

    if (!list || !API_BASE) return;

    // APIは投稿記事・同人誌を区別せず横断でランキングを返すため、表示件数(limit)だけを
    // 取得件数にすると、このウィジェットが対象とする種別（rankingIndexに含まれる方）が
    // 上位に少ない場合に表示件数が足りなくなる。取得件数は多めに確保し、種別で絞り込んだ
    // 上で改めてlimit件に切り詰める
    const fetchLimit = Math.max(limit * 10, 50);

    function buildCard(entry: RankingEntry, rank: number, count: number) {
      const a = document.createElement("a");
      a.className = "ranking-item";
      a.href = entry.href;
      a.dataset.rank = String(rank);
      a.innerHTML = `
        <span class="ranking-rank">${rank}</span>
        <img class="ranking-thumb" src="${entry.thumb}" alt="" loading="lazy" />
        <div class="ranking-fade" aria-hidden="true"></div>
        <div class="ranking-text">
          <span class="ranking-title">${escapeHtml(entry.title)}</span>
          <span class="ranking-likes"><i class="ti ti-heart" aria-hidden="true"></i>${count}</span>
        </div>
      `;
      return a;
    }

    function render(rows: RankingRow[]) {
      if (!list) return;
      list.innerHTML = "";
      const resolved = rows
        .map((row) => ({ row, entry: rankingIndexBySlug.get(row.slug) }))
        .filter((item): item is { row: RankingRow; entry: RankingEntry } => Boolean(item.entry))
        .slice(0, limit);

      if (resolved.length === 0) {
        const empty = document.createElement("p");
        empty.className = "ranking-empty";
        empty.textContent = list.dataset.emptyText ?? "";
        list.append(empty);
        return;
      }

      resolved.forEach(({ row, entry }, index) => {
        list.append(buildCard(entry, index + 1, row.count));
      });
    }

    async function fetchRanking(url: string): Promise<RankingRow[]> {
      const res = await fetch(url);
      if (!res.ok) throw new Error(`ranking fetch failed: ${res.status}`);
      const data = await res.json();
      return (data.ranking ?? []) as RankingRow[];
    }

    async function load() {
      let rows: RankingRow[];
      try {
        rows = await fetchRanking(`${API_BASE}/likes/ranking?limit=${fetchLimit}`);
      } catch {
        // Workerが無料枠上限などで応答しない場合、ビルド時に生成した静的スナップショットに
        // フォールバックする（同一オリジン配信なのでWorkerの生死に関係なく取得できる）
        try {
          rows = await fetchRanking(SNAPSHOT_URL);
        } catch {
          return; // どちらも取得できない場合は非表示のままにする
        }
      }

      if (!rows.some((row) => rankingIndexBySlug.has(row.slug))) return;

      render(rows);
      hideTarget.removeAttribute("hidden");
    }

    load();
  }

  document.querySelectorAll<HTMLElement>(".ranking-widget").forEach(initRankingWidget);
</script>

<style is:global>
  .ranking-widget {
    display: grid;
    gap: 0.75rem;
    grid-column: 1 / -1;
  }

  .ranking-list {
    display: grid;
    gap: 0.6rem;
  }

  .ranking-item {
    position: relative;
    display: flex;
    align-items: center;
    height: 92px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-elevated-2);
    text-decoration: none;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }
  .ranking-item:hover {
    color: var(--text-primary);
  }

  .ranking-thumb {
    position: absolute;
    inset: 0 0 0 auto;
    width: auto;
    max-width: 70%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 50%);
    mask-image: linear-gradient(to right, transparent 0%, #000 50%);
    z-index: 0;
  }

  .ranking-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--bg-elevated-2) 0%, var(--bg-elevated-2) 32%, transparent 92%);
    z-index: 1;
  }

  .ranking-rank {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    width: 2.2rem;
    text-align: center;
    font-size: 1.05rem;
    font-weight: 700;
    font-style: italic;
    color: var(--text-muted);
  }
  .ranking-item[data-rank="1"] .ranking-rank {
    color: #f2c14e;
  }
  .ranking-item[data-rank="2"] .ranking-rank {
    color: #cbd3dc;
  }
  .ranking-item[data-rank="3"] .ranking-rank {
    color: #e0925a;
  }

  .ranking-text {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.25rem;
    padding: 0 1rem 0 0.15rem;
    min-width: 0;
  }

  .ranking-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 10.5rem;
  }

  .ranking-likes {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .ranking-likes i {
    color: var(--heart);
    font-size: 12px;
  }

  .ranking-empty {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .ranking-see-more {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    justify-self: end;
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .ranking-see-more:hover {
    color: var(--text-primary);
  }

  @media (width <= 768px) {
    .ranking-title {
      max-width: 8.5rem;
    }
  }
</style>
