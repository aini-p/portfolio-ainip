---
import { ui } from "~/i18n/ui";

const { pathname } = Astro.url;
const { lang } = Astro.locals;
const t = ui[lang];

// ▼▼▼ ナビゲーションとスイッチャーのパス生成ロジックを修正 ▼▼▼
const galleryPath = lang === "ja" ? "/" : "/en";
const profilePath = lang === "ja" ? "/profile" : "/en/profile";
const toolPath = lang === "ja" ? "/tools" : "/en/tools";

let jaPath: string, enPath: string;
if (lang === "en") {
  // 現在英語ページ (/en/foo)
  jaPath = pathname.replace(/^\/en/, "") || "/"; // /en を削除、空なら /
  enPath = pathname;
} else {
  // 現在日本語ページ (/foo)
  jaPath = pathname;
  enPath = `/en${pathname === "/" ? "" : pathname}`; // /en を先頭に追加 (ルートの場合は /en)
}
// ルートパスの場合、末尾のスラッシュを保証
if (jaPath === "") jaPath = "/";
if (enPath === "/en") enPath = "/en/";
// ▲▲▲ ここまで ▲▲▲
---
<header>
  <nav>
    {/* ▼▼▼ hrefとactiveの判定を修正 ▼▼▼ */}
    <a href={galleryPath} class:list={{ active: pathname === '/' || pathname === '/en' || pathname === '/en/' }}>{t['nav.gallery']}</a>
    <a href={profilePath} class:list={{ active: pathname.startsWith('/profile') || pathname.startsWith('/en/profile') }}>{t['nav.profile']}</a>
    <a href={toolPath} class:list={{ active: pathname.startsWith('/tools') || pathname.startsWith('/en/tools') || pathname === '/tool' || pathname === '/en/tool' }}>{t['nav.tool']}</a>
    {/* ▲▲▲ ここまで ▲▲▲ */}
  </nav>
  <div class="language-switcher">
    {lang === 'ja' ? <span>JA</span> : <a href={jaPath}>JA</a>}
    <span>|</span>
    {lang === 'en' ? <span>EN</span> : <a href={enPath}>EN</a>}
  </div>
</header>
<style>
  /* ... (styleタグの中身は変更なし) ... */
  header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    background-color: rgb(255 255 255 / 70%);
    backdrop-filter: blur(10px);
    z-index: 10;
  }

  nav {
    display: flex;
    gap: 2rem;
  }

  nav a {
    color: #333;
    text-decoration: none;
    font-weight: 600;
    padding: 0.5rem 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.3s;
    font-size: 0.9rem;
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: absolute;
    right: 1.5rem;
    font-weight: 600;
  }

  .language-switcher a {
    color: #888;
    text-decoration: none;
  }

  .language-switcher span {
    color: #333;
  }

  nav a:hover,
  nav a.active {
    border-color: #333;
  }

  /* ▼▼▼ モバイル対応を追加 ▼▼▼ */
  @media (width <= 768px) {
    header {
      justify-content: space-between;
      padding: 0.5rem 1rem;
    }

    nav {
      gap: 1rem;
    }

    nav a {
      font-size: 0.8rem;
      padding: 0.3rem 0;
    }

    .language-switcher {
      position: static;
      font-size: 0.8rem;
    }
  }

  @media (prefers-color-scheme: dark) {
    header {
      background-color: rgb(0 0 0 / 70%);
    }

    nav a {
      color: #eee;
    }

    .language-switcher a {
      color: #777;
    }

    .language-switcher span {
      color: #eee;
    }

    nav a:hover,
    nav a.active {
      border-color: #eee;
    }
  }
</style>