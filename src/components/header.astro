---
import { ui } from "~/i18n/ui";

const { pathname } = Astro.url;
const { lang } = Astro.locals;
const t = ui[lang];
const prefix = lang === "en" ? "/en" : "";

function withLang(path: string) {
  if (path === "/") return lang === "en" ? "/en" : "/";
  return `${prefix}${path}`;
}

const navItems = [
  {
    key: "nav.gallery",
    path: "/",
    match: (p: string) => p === "/" || p === "/en" || p === "/en/",
  },
  {
    key: "nav.doujinshi",
    path: "/doujinshi",
    match: (p: string) => p.includes("/doujinshi"),
  },
  {
    key: "nav.tool",
    path: "/tools",
    match: (p: string) =>
      p.includes("/tools") || p === "/tool" || p === "/en/tool",
  },
  {
    key: "nav.profile",
    path: "/profile",
    match: (p: string) => p.includes("/profile"),
  },
] as const;

const galleryPath = withLang("/");

let jaPath: string, enPath: string;
if (lang === "en") {
  jaPath = pathname.replace(/^\/en/, "") || "/";
  enPath = pathname;
} else {
  jaPath = pathname;
  enPath = `/en${pathname === "/" ? "" : pathname}`;
}
if (jaPath === "") jaPath = "/";
if (enPath === "/en") enPath = "/en/";
---
<header>
  <a href={galleryPath} class="brand">{lang === "ja" ? "あと5分。" : "At5Fun"}</a>

  <nav class="nav-desktop">
    {navItems.map((item) => (
      <a href={withLang(item.path)} class:list={{ active: item.match(pathname) }}>{t[item.key]}</a>
    ))}
    <a href={withLang("/membership")} class:list={["cta-membership", { active: pathname.includes("/membership") }]}>{t["nav.membership"]}</a>
  </nav>

  <div class="language-switcher">
    {lang === "ja" ? <span>JA</span> : <a href={jaPath}>JA</a>}
    <span>|</span>
    {lang === "en" ? <span>EN</span> : <a href={enPath}>EN</a>}
  </div>

  <button type="button" class="menu-toggle" aria-label={t["nav.menu"]} aria-expanded="false" aria-controls="mobile-nav">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav id="mobile-nav" class="nav-mobile">
    {navItems.map((item) => (
      <a href={withLang(item.path)} class:list={{ active: item.match(pathname) }}>{t[item.key]}</a>
    ))}
    <a href={withLang("/membership")} class:list={["cta-membership", { active: pathname.includes("/membership") }]}>{t["nav.membership"]}</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = mobileNav?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
    toggle.classList.toggle("is-open", Boolean(isOpen));
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileNav.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.classList.remove("is-open");
    });
  });
</script>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.85rem 1.5rem;
    background-color: rgb(23 20 28 / 78%);
    backdrop-filter: blur(10px);
    border-bottom: 0.5px solid var(--border-subtle);
    z-index: 20;
  }

  .brand {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    flex: 1;
  }

  nav a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    padding: 0.5rem 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  nav a:hover,
  nav a.active {
    color: var(--text-primary);
    border-color: var(--accent-strong);
  }

  .cta-membership {
    margin-left: auto;
    padding: 0.45rem 0.95rem !important;
    border-radius: 999px;
    background: var(--accent);
    color: #fff !important;
    border-bottom: none !important;
  }

  .cta-membership:hover {
    background: var(--accent-strong);
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.85rem;
  }

  .language-switcher a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
  }

  .language-switcher span {
    color: var(--text-primary);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .menu-toggle span {
    width: 100%;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .menu-toggle.is-open span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle.is-open span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.is-open span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav-mobile {
    display: none;
  }

  @media (width <= 860px) {
    header {
      justify-content: space-between;
      padding: 0.7rem 1rem;
    }

    .nav-desktop {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .nav-mobile {
      display: flex;
      position: fixed;
      top: 56px;
      left: 0;
      width: 100%;
      flex-direction: column;
      gap: 0;
      background: var(--bg-elevated);
      border-bottom: 0.5px solid var(--border-subtle);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .nav-mobile.is-open {
      max-height: 420px;
    }

    .nav-mobile a {
      padding: 0.9rem 1.25rem;
      border-bottom: 0.5px solid var(--border-subtle);
      border-left: 2px solid transparent;
    }

    .nav-mobile a.active {
      border-left-color: var(--accent-strong);
      border-bottom-color: var(--border-subtle);
    }

    .cta-membership {
      margin-left: 0;
      padding: 0.9rem 1.25rem !important;
      border-radius: 0;
      border-bottom: 0.5px solid var(--border-subtle) !important;
      text-align: center;
    }
  }
</style>
