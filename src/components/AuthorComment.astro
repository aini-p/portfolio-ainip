---
export interface Props {
  heading: string;
  profileLabel: string;
  profileHref?: string;
}

const { heading, profileLabel, profileHref = "/profile" } = Astro.props;
---
<div class="comment-callout">
  <a href={profileHref} class="comment-icon-link" aria-label={profileLabel}>
    <img src="/images/icon.png" alt="" class="comment-icon" />
  </a>
  <div class="comment-content">
    <p class="comment-heading">{heading}</p>
    <div class="comment-body"><slot /></div>
  </div>
</div>

<style>
  .comment-callout {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
    border: 0.5px solid var(--accent);
  }

  .comment-icon-link {
    flex-shrink: 0;
    display: block;
    border-radius: 50%;
    transition: transform 0.2s ease;
  }
  .comment-icon-link:hover,
  .comment-icon-link:focus-visible {
    transform: scale(1.06);
  }

  .comment-icon {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent);
  }

  .comment-content {
    min-width: 0;
    display: grid;
    gap: 0.5rem;
  }

  .comment-heading {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent-strong);
  }

  .comment-body {
    line-height: 1.85;
    color: var(--text-secondary);
  }

  @media (width <= 600px) {
    .comment-callout { padding: 1.1rem; gap: 0.85rem; }
    .comment-icon { width: 44px; height: 44px; }
  }
</style>
