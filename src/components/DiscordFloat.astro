---
import { discordUrl } from "~/constants/social";
import { ui } from "~/i18n/ui";

export interface Props {
  lang: "ja" | "en";
}

const { lang } = Astro.props;
const t = ui[lang];
---
<div class="discord-float" id="discord-float">
  <button type="button" class="discord-float-close" id="discord-float-close" aria-label="close">
    <i class="ti ti-x" aria-hidden="true"></i>
  </button>
  <a class="discord-float-link" href={discordUrl} target="_blank" rel="noopener noreferrer">
    <i class="ti ti-brand-discord" aria-hidden="true"></i>
    <span class="discord-float-text">{t["discord.floatText"]}</span>
  </a>
</div>

<script>
  const STORAGE_KEY = "discord-float-dismissed";
  const el = document.getElementById("discord-float");
  const closeBtn = document.getElementById("discord-float-close");

  if (el && sessionStorage.getItem(STORAGE_KEY)) {
    el.style.display = "none";
  }

  closeBtn?.addEventListener("click", () => {
    sessionStorage.setItem(STORAGE_KEY, "1");
    if (el) el.style.display = "none";
  });
</script>

<style is:global>
  .discord-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 40;
  }

  .discord-float-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: #4b5ac4;
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 4px 16px rgb(0 0 0 / 35%);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .discord-float-link:hover,
  .discord-float-link:focus-visible {
    background: #5b6ad8;
    transform: translateY(-2px);
  }
  .discord-float-link i.ti-brand-discord {
    font-size: 20px;
  }

  .discord-float-close {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 22px;
    height: 22px;
    padding: 0;
    border-radius: 50%;
    background: var(--bg-elevated);
    border: 0.5px solid var(--border-strong);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    cursor: pointer;
  }
  .discord-float-close:hover {
    color: var(--text-primary);
    border-color: var(--accent-strong);
  }

  @media (width <= 768px) {
    .discord-float {
      right: 0.75rem;
      bottom: 0.75rem;
    }
    .discord-float-link {
      padding: 0.6rem 0.9rem;
      font-size: 0.8rem;
    }
  }
</style>
