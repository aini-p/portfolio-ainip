---
import "~/styles/tool-composer.css";

export interface Props {
  bannerSrc?: string;
  bannerAlt?: string;
  shareUrl?: string;
  copy: {
    title: string;
    lead: string;
    imagesInput: string;
    dropHint: string;
    chooseButton: string;
    fileHint: string;
    imageCount: string;
    removeImage: string;
    shuffleButton: string;
    resolutionLabel: string;
    resolutionHelp: string;
    paddingLabel: string;
    paddingHelp: string;
    rotationLabel: string;
    rotationHelp: string;
    scaleLabel: string;
    scaleHelp: string;
    generateScale: string;
    generate: string;
    download: string;
    preview: string;
    statusIdle: string;
    statusNeedImages: string;
    statusWorking: string;
    statusReady: string;
    statusError: string;
    noteOptimization: string;
    notePadding: string;
    contactLabel: string;
    contactLinkText: string;
    contactHref: string;
    shareButton: string;
    shareText: string;
  };
}

const { copy, bannerSrc, bannerAlt = "", shareUrl } = Astro.props;
const xShareHref = shareUrl
  ? `https://twitter.com/intent/tweet?text=${encodeURIComponent(copy.shareText)}&url=${encodeURIComponent(shareUrl)}`
  : undefined;
---

<section
  class="tool-shell"
  data-random-pack-tool
  data-status-idle={copy.statusIdle}
  data-status-need-images={copy.statusNeedImages}
  data-status-working={copy.statusWorking}
  data-status-ready={copy.statusReady}
  data-status-error={copy.statusError}
>
  <div class="hero-card">
    {bannerSrc && (
      <>
        <img class="hero-banner" src={bannerSrc} alt={bannerAlt} />
        <div class="hero-overlay" aria-hidden="true"></div>
      </>
    )}
    <div class="hero-content">
      <p class="eyebrow">Random Pack Tool</p>
      <h1>{copy.title}</h1>
      <p class="lead">{copy.lead}</p>
      {xShareHref && (
        <a class="share-button" href={xShareHref} target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="16" height="16">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.623 5.905-5.623Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          {copy.shareButton}
        </a>
      )}
    </div>
  </div>

  <div class="workspace-grid">
    <form class="control-panel">
      <label class="file-field file-dropzone" data-role="drop-source">
        <span>{copy.imagesInput}</span>
        <p class="drop-hint">{copy.dropHint}</p>
        <button class="browse-button" data-role="browse-source" type="button">{copy.chooseButton}</button>
        <p class="image-count" data-role="image-count"></p>
        <div class="image-list" data-role="image-list"></div>
        <input data-role="input-source" type="file" accept="image/*" multiple />
      </label>

      <button class="shuffle-button" data-role="shuffle-button" type="button" disabled>{copy.shuffleButton}</button>

      <label class="range-field">
        <span>{copy.resolutionLabel}</span>
        <div class="resolution-inputs">
          <div class="input-group">
            <label for="res-width">幅（px）</label>
            <input id="res-width" data-role="res-width" type="number" min="320" max="2560" step="1" value="1920" />
          </div>
          <div class="input-group">
            <label for="res-height">高さ（px）</label>
            <input id="res-height" data-role="res-height" type="number" min="180" max="1440" step="1" value="1080" />
          </div>
        </div>
        <p class="help-text">{copy.resolutionHelp}</p>
      </label>

      <label class="range-field">
        <span>{copy.paddingLabel}</span>
        <input data-role="padding-input" type="number" min="0" max="100" step="1" value="8" />
        <p class="help-text">{copy.paddingHelp}</p>
      </label>

      <label class="range-field">
        <span>{copy.rotationLabel}</span>
        <input data-role="rotation-input" type="range" min="-180" max="180" step="1" value="0" />
        <p class="rotation-value" data-role="rotation-value">0°</p>
        <p class="help-text">{copy.rotationHelp}</p>
      </label>

      <label class="range-field">
        <span>{copy.scaleLabel}</span>
        <input data-role="scale-input" type="range" min="0.5" max="2.0" step="0.1" value="1.0" />
        <p class="scale-value" data-role="scale-value">100%</p>
        <p class="help-text">{copy.scaleHelp}</p>
      </label>

      <p class="scale-info" data-role="scale-info"></p>

      <div class="action-row">
        <button data-role="generate-button" type="button" disabled>{copy.generate}</button>
        <button data-role="download-button" type="button" disabled data-ga-event="tool_download" data-ga-tool="random-pack-image">{copy.download}</button>
      </div>

      <p class="status-text" data-role="status" aria-live="polite">{copy.statusIdle}</p>
    </form>

    <div class="preview-panel">
      <div class="preview-card">
        <p>{copy.preview}</p>
        <canvas class="preview-canvas" data-role="preview-canvas" width="640" height="360"></canvas>
      </div>
    </div>
  </div>

  <section class="notes-panel">
    <ul class="notes-list">
      <li>{copy.fileHint}</li>
      <li>{copy.noteOptimization}</li>
      <li>{copy.notePadding}</li>
      <li>
        {copy.contactLabel}
        <a class="notes-link" href={copy.contactHref}>{copy.contactLinkText}</a>
      </li>
    </ul>
  </section>
</section>

<style>
  /* ランダムパックツール固有のスタイル。共通の見た目は tool-composer.css を参照 */
  .image-list {
    display: grid;
    gap: 0.5rem;
  }

  .image-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.6rem;
    background: var(--panel-bg-soft);
    border: 1px solid var(--panel-border);
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
  }

  .image-item-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .image-item-remove {
    border: 0;
    background: color-mix(in srgb, #ef4444 30%, transparent);
    color: #fca5a5;
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    flex-shrink: 0;
  }

  .image-item-remove:hover {
    background: color-mix(in srgb, #ef4444 50%, transparent);
  }

  .resolution-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
  }

  .input-group {
    display: grid;
    gap: 0.3rem;
  }

  .input-group label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .input-group input {
    width: 100%;
  }

  .rotation-value,
  .scale-value,
  .scale-info {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .preview-canvas {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background: #fff;
  }

  @media (width <= 640px) {
    .resolution-inputs {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  function initRandomPackTool(root) {
    if (root.dataset.initialized === "true") {
      return;
    }
    root.dataset.initialized = "true";

    const sourceInput = root.querySelector('[data-role="input-source"]');
    const sourceDropzone = root.querySelector('[data-role="drop-source"]');
    const sourceBrowseButton = root.querySelector('[data-role="browse-source"]');
    const imageCount = root.querySelector('[data-role="image-count"]');
    const imageList = root.querySelector('[data-role="image-list"]');
    const shuffleButton = root.querySelector('[data-role="shuffle-button"]');
    const resWidthInput = root.querySelector('[data-role="res-width"]');
    const resHeightInput = root.querySelector('[data-role="res-height"]');
    const paddingInput = root.querySelector('[data-role="padding-input"]');
    const rotationInput = root.querySelector('[data-role="rotation-input"]');
    const rotationValue = root.querySelector('[data-role="rotation-value"]');
    const scaleInput = root.querySelector('[data-role="scale-input"]');
    const scaleValue = root.querySelector('[data-role="scale-value"]');
    const generateButton = root.querySelector('[data-role="generate-button"]');
    const downloadButton = root.querySelector('[data-role="download-button"]');
    const status = root.querySelector('[data-role="status"]');
    const previewCanvas = root.querySelector('[data-role="preview-canvas"]');

    const labels = {
      idle: root.dataset.statusIdle || "",
      needImages: root.dataset.statusNeedImages || "",
      working: root.dataset.statusWorking || "",
      ready: root.dataset.statusReady || "",
      error: root.dataset.statusError || "",
    };

    const state = {
      files: [],
      images: [],
      order: [],
      rotation: 0,
      scale: 1.0,
      outputCanvas: null,
      previewUrl: "",
    };

    function setStatus(message) {
      if (status) {
        status.textContent = message;
      }
    }

    function setGenerateReady(ready) {
      if (generateButton) {
        generateButton.disabled = !ready;
      }
    }

    function setDownloadReady(ready) {
      if (downloadButton) {
        downloadButton.disabled = !ready;
      }
    }

    function invalidateGeneratedOutput() {
      state.outputCanvas = null;
      setDownloadReady(false);
      if (state.files.length >= 2) {
        setGenerateReady(true);
      }
    }

    function revokeUrl(url) {
      if (url) {
        URL.revokeObjectURL(url);
      }
    }

    function updateFileLabel() {
      if (!imageCount) {
        return;
      }
      const count = state.files.length;
      imageCount.textContent = count > 0 ? `選択済み: ${count}枚` : "";
      setGenerateReady(count >= 2);
      if (shuffleButton) {
        shuffleButton.disabled = count < 2;
      }
    }

    function renderImageList() {
      if (!imageList) {
        return;
      }
      imageList.innerHTML = "";
      state.files.forEach((file, index) => {
        const item = document.createElement("div");
        item.className = "image-item";
        const nameSpan = document.createElement("span");
        nameSpan.className = "image-item-name";
        nameSpan.textContent = file.name;
        const removeBtn = document.createElement("button");
        removeBtn.className = "image-item-remove";
        removeBtn.type = "button";
        removeBtn.textContent = "削除";
        removeBtn.onclick = (e) => {
          e.preventDefault();
          removeImageAt(index);
        };
        item.appendChild(nameSpan);
        item.appendChild(removeBtn);
        imageList.appendChild(item);
      });
    }

    function removeImageAt(index) {
      state.files.splice(index, 1);
      state.images.splice(index, 1);
      state.order.splice(index, 1);
      invalidateGeneratedOutput();
      updateFileLabel();
      renderImageList();
    }

    function shuffleOrder() {
      if (state.files.length < 2) {
        return;
      }
      state.order = state.files.map((_, i) => i);
      for (let i = state.order.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [state.order[i], state.order[j]] = [state.order[j], state.order[i]];
      }
      invalidateGeneratedOutput();
    }

    function loadImageFromFile(file) {
      return new Promise((resolve, reject) => {
        const objectUrl = URL.createObjectURL(file);
        const image = new Image();
        image.onload = () => {
          URL.revokeObjectURL(objectUrl);
          resolve(image);
        };
        image.onerror = () => {
          URL.revokeObjectURL(objectUrl);
          reject(new Error("image-load-failed"));
        };
        image.src = objectUrl;
      });
    }

    async function loadAllImages() {
      const loadedImages = [];
      for (let i = 0; i < state.files.length; i++) {
        try {
          const img = await loadImageFromFile(state.files[i]);
          loadedImages.push(img);
        } catch (err) {
          console.error("Failed to load image:", err);
          setStatus(labels.error);
          return null;
        }
      }
      return loadedImages;
    }

    function calculateLayout(images, outputWidth, outputHeight, padding, rotation, scale) {
      const totalImages = images.length;
      if (totalImages === 0) return [];

      const rad = (rotation * Math.PI) / 180;

      const aspectRatios = images.map((img) => img.naturalWidth / img.naturalHeight);
      const avgAspect = aspectRatios.reduce((a, b) => a + b) / aspectRatios.length;

      let colsFactor = 1;
      if (rotation !== 0 && rotation !== 180 && rotation !== -180) {
        colsFactor = Math.abs(Math.cos(rad));
      }

      const cols = Math.max(1, Math.ceil(Math.sqrt(totalImages * avgAspect * colsFactor)));
      // 外周余白は持たず、画像間のパディングだけ維持する
      const availableWidth = Math.max(1, outputWidth - padding * (cols - 1));
      const rows = [];
      let idx = 0;

      while (idx < totalImages) {
        const rowImageIndexes = [];
        let rowTotalAspect = 0;

        for (let i = 0; i < cols && idx < totalImages; i++) {
          const orderIndex = state.order[idx];
          rowImageIndexes.push(orderIndex);
          rowTotalAspect += aspectRatios[orderIndex];
          idx++;
        }

        const rowHeight = (availableWidth / Math.max(rowTotalAspect, 0.001)) * scale;
        const widths = rowImageIndexes.map((imgIdx) => rowHeight * aspectRatios[imgIdx]);
        const rowWidth = widths.reduce((sum, width) => sum + width, 0);
        rows.push({ rowImageIndexes, rowHeight, widths, rowWidth });
      }

      const totalHeight =
        rows.reduce((sum, row) => sum + row.rowHeight, 0) + padding * Math.max(rows.length - 1, 0);
      let y = (outputHeight - totalHeight) / 2;
      const positions = [];

      rows.forEach((row) => {
        const rowBoxWidth = row.rowWidth + padding * Math.max(row.rowImageIndexes.length - 1, 0);
        let x = (outputWidth - rowBoxWidth) / 2;

        row.rowImageIndexes.forEach((imgIdx, rowIndex) => {
          const imgWidth = row.widths[rowIndex];
          positions.push({
            index: imgIdx,
            x,
            y,
            width: imgWidth,
            height: row.rowHeight,
          });
          x += imgWidth + padding;
        });

        y += row.rowHeight + padding;
      });

      return positions;
    }

    function drawImage(ctx, image, x, y, width, height) {
      // 元の画像のアスペクト比を保ったまま描画
      const srcW = image.naturalWidth;
      const srcH = image.naturalHeight;
      const srcRatio = srcW / srcH;

      // 領域の高さを基準に、元の画像のアスペクト比を保った幅を計算
      const baseHeight = height;
      const baseWidth = baseHeight * srcRatio;

      // 領域の中央を基準に配置
      const drawX = x + (width - baseWidth) / 2;
      const drawY = y + (height - baseHeight) / 2;

      ctx.drawImage(image, 0, 0, srcW, srcH, drawX, drawY, baseWidth, baseHeight);
    }

    function renderToCanvas(images, width, height, padding, rotation, scale) {
      const canvas = document.createElement("canvas");
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext("2d");
      if (!ctx) {
        throw new Error("Failed to get canvas context");
      }

      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, width, height);

      const positions = calculateLayout(images, width, height, padding, rotation, scale);
      if (rotation !== 0) {
        ctx.save();
        ctx.translate(width / 2, height / 2);
        ctx.rotate((rotation * Math.PI) / 180);
        ctx.translate(-width / 2, -height / 2);
      }

      positions.forEach((pos) => {
        drawImage(ctx, images[pos.index], pos.x, pos.y, pos.width, pos.height);
      });

      if (rotation !== 0) {
        ctx.restore();
      }

      return canvas;
    }

    function getOutputSize() {
      const width = Math.min(Math.max(parseInt(resWidthInput.value) || 1920, 320), 2560);
      const height = Math.min(Math.max(parseInt(resHeightInput.value) || 1080, 180), 1440);
      return { width, height };
    }

    function syncPreviewCanvasSize() {
      if (!previewCanvas) {
        return;
      }
      const { width, height } = getOutputSize();
      previewCanvas.width = width;
      previewCanvas.height = height;
    }

    function drawPreview() {
      if (!previewCanvas) {
        return;
      }

      syncPreviewCanvasSize();

      if (state.images.length === 0) {
        return;
      }

      const previewW = previewCanvas.width;
      const previewH = previewCanvas.height;
      const ctx = previewCanvas.getContext("2d");
      if (!ctx) {
        return;
      }

      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, previewW, previewH);

      try {
        const { width, height } = getOutputSize();
        const tempCanvas = renderToCanvas(
          state.images,
          width,
          height,
          parseInt(paddingInput.value) || 8,
          state.rotation,
          state.scale
        );
        ctx.drawImage(tempCanvas, 0, 0, previewW, previewH);
      } catch (err) {
        console.error("Preview render failed:", err);
      }
    }

    async function generateComposite() {
      setStatus(labels.working);
      setGenerateReady(false);
      setDownloadReady(false);

      try {
        const { width, height } = getOutputSize();
        const padding = Math.max(parseInt(paddingInput.value) || 8, 0);

        state.images = await loadAllImages();
        if (!state.images || state.images.length === 0) {
          setStatus(labels.error);
          return;
        }

        state.outputCanvas = renderToCanvas(state.images, width, height, padding, state.rotation, state.scale);

        revokeUrl(state.previewUrl);
        state.previewUrl = state.outputCanvas.toDataURL("image/png");

        setStatus(labels.ready);
        setDownloadReady(true);
        drawPreview();
      } catch (err) {
        console.error("Generation failed:", err);
        setStatus(labels.error);
        setGenerateReady(true);
      }
    }

    function downloadComposite() {
      if (!state.outputCanvas) {
        return;
      }

      const link = document.createElement("a");
      link.href = state.outputCanvas.toDataURL("image/png");
      link.download = "random-pack-image.png";
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function handleFilesSelected(files) {
      Array.from(files).forEach((file) => {
        if (file.type.startsWith("image/")) {
          state.files.push(file);
        }
      });

      state.order = state.files.map((_, i) => i);
      shuffleOrder();
      invalidateGeneratedOutput();
      updateFileLabel();
      renderImageList();
      setStatus(state.files.length >= 2 ? labels.idle : labels.needImages);
    }

    // Event listeners
    if (sourceBrowseButton) {
      sourceBrowseButton.addEventListener("click", (e) => {
        e.preventDefault();
        sourceInput?.click();
      });
    }

    if (sourceInput) {
      sourceInput.addEventListener("change", (e) => {
        const target = e.target;
        if (target && target.files) {
          handleFilesSelected(target.files);
        }
      });
    }

    if (sourceDropzone) {
      sourceDropzone.addEventListener("dragover", (e) => {
        e.preventDefault();
        sourceDropzone.classList.add("is-dragover");
      });

      sourceDropzone.addEventListener("dragleave", () => {
        sourceDropzone.classList.remove("is-dragover");
      });

      sourceDropzone.addEventListener("drop", (e) => {
        e.preventDefault();
        sourceDropzone.classList.remove("is-dragover");
        if (e.dataTransfer && e.dataTransfer.files) {
          handleFilesSelected(e.dataTransfer.files);
        }
      });
    }

    if (shuffleButton) {
      shuffleButton.addEventListener("click", (e) => {
        e.preventDefault();
        shuffleOrder();
        drawPreview();
      });
    }

    if (rotationInput) {
      rotationInput.addEventListener("input", (e) => {
        const target = e.target;
        if (target) {
          state.rotation = parseInt(target.value) || 0;
          if (rotationValue) {
            rotationValue.textContent = `${state.rotation}°`;
          }
          invalidateGeneratedOutput();
        }
      });
    }

    if (scaleInput) {
      scaleInput.addEventListener("input", (e) => {
        const target = e.target;
        if (target) {
          state.scale = parseFloat(target.value) || 1.0;
          if (scaleValue) {
            scaleValue.textContent = `${Math.round(state.scale * 100)}%`;
          }
          invalidateGeneratedOutput();
          drawPreview();
        }
      });
    }

    if (resWidthInput) {
      resWidthInput.addEventListener("input", () => {
        invalidateGeneratedOutput();
        drawPreview();
      });
    }

    if (resHeightInput) {
      resHeightInput.addEventListener("input", () => {
        invalidateGeneratedOutput();
        drawPreview();
      });
    }

    if (paddingInput) {
      paddingInput.addEventListener("input", () => {
        invalidateGeneratedOutput();
        drawPreview();
      });
    }

    if (generateButton) {
      generateButton.addEventListener("click", (e) => {
        e.preventDefault();
        generateComposite();
      });
    }

    if (downloadButton) {
      downloadButton.addEventListener("click", (e) => {
        e.preventDefault();
        downloadComposite();
      });
    }

    syncPreviewCanvasSize();
    setStatus(labels.idle);
  }

  document.querySelectorAll("[data-random-pack-tool]").forEach((root) => {
    initRandomPackTool(root);
  });

  const observer = new MutationObserver(() => {
    document.querySelectorAll("[data-random-pack-tool]").forEach((root) => {
      if (root.dataset.initialized !== "true") {
        initRandomPackTool(root);
      }
    });
  });

  observer.observe(document.body, { childList: true, subtree: true });
</script>
</script>
