---
import HomeStyleSidebars from "~/components/HomeStyleSidebars.astro";
import ProfileContent from "~/components/ProfileContent.astro";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

const lang = "ja"; // 日本語ページとして固定
const t = ui[lang];

const profileDescription =
  "イラストレーター / AI+加筆 / お仕事のご依頼はDMまで。";
const profilePageTitle = t["nav.profile"];
const profileKeywords = "プロフィール, イラスト, AIイラスト, あと5分。";
const pageUrl = new URL("/", Astro.site).toString();
---
<BaseLayout
  title={profilePageTitle}
  description={profileDescription}
  keywords={profileKeywords}
  image={{ src: "/images/profile-share-card.png", alt: "プロフィールページのシェアカード画像" }}
>
  <div class="sidebar-page-shell">
   <div class="sidebar-page-grid">
    <HomeStyleSidebars lang={lang}>
      <div class="main-column">
        <ProfileContent lang={lang} profileDescription={profileDescription} pageUrl={pageUrl} />
      </div>
    </HomeStyleSidebars>
   </div>
  </div>
</BaseLayout>
