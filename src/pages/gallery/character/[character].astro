---
import { type CollectionEntry, getCollection } from "astro:content";
import ArtworkCard from "~/components/ArtworkCard.astro";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  formatImageCountLabel,
  getArtworkCharacters,
  getHeaderImage,
  getTotalImageCount,
} from "~/utils/artwork";
import { toPathSafeSlug } from "~/utils/slug";

const lang = "ja";
const t = ui[lang];

export async function getStaticPaths() {
  const artworks = await getCollection("artworks", ({ id }) =>
    id.startsWith("ja/"),
  );
  const paths: {
    params: { character: string };
    props: { artworks: CollectionEntry<"artworks">[]; characterName: string };
  }[] = [];
  const charactersMap = new Map<string, CollectionEntry<"artworks">[]>();

  for (const artwork of artworks) {
    const allCharacters = getArtworkCharacters(artwork);

    for (const char of allCharacters) {
      if (!charactersMap.has(char)) {
        charactersMap.set(char, []);
      }
      charactersMap.get(char)?.push(artwork);
    }
  }

  for (const [character, collection] of charactersMap.entries()) {
    paths.push({
      params: { character: toPathSafeSlug(character) },
      props: {
        characterName: character,
        artworks: collection.sort(
          (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
        ),
      },
    });
  }
  return paths;
}

const { artworks, characterName } = Astro.props;
---
<BaseLayout title={`${characterName} - ${t['nav.gallery']}`}>
  <div class="list-container">
    <h1>{characterName}</h1>
    <section class="card-grid">
      {artworks.map((artwork, index) => (
        <ArtworkCard
          href={`/gallery/${artwork.slug.replace(`${lang}/`, "")}`}
          title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
          image={getHeaderImage(artwork)}
          slug={artwork.slug.replace(`${lang}/`, "")}
          eager={index < 8}
        />
      ))}
    </section>
  </div>
</BaseLayout>
<style is:inline>
  .list-container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
  h1 { font-size: 2rem; font-weight: 500; margin-bottom: 1.5rem; color: var(--text-primary); }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.1rem;
  }
  @media (max-width: 768px) {
    .list-container { padding: 1rem; }
    h1 { font-size: 1.5rem; }
    .card-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.85rem; }
  }
</style>
