---
import { type CollectionEntry, getCollection } from "astro:content";
import ArtworkCard from "~/components/ArtworkCard.astro";
import HomeStyleSidebars from "~/components/HomeStyleSidebars.astro";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  formatImageCountLabel,
  getHeaderImage,
  getTotalImageCount,
} from "~/utils/artwork";
import { toPathSafeSlug } from "~/utils/slug";

const lang = "ja";
const t = ui[lang];

export async function getStaticPaths() {
  const artworks = await getCollection("artworks", ({ id }) =>
    id.startsWith("ja/"),
  );
  const paths: {
    params: { series: string };
    props: { artworks: CollectionEntry<"artworks">[]; seriesName: string };
  }[] = [];
  const seriesMap = new Map<string, CollectionEntry<"artworks">[]>();

  for (const artwork of artworks) {
    if (artwork.data.series) {
      const series = artwork.data.series;
      if (!seriesMap.has(series)) {
        seriesMap.set(series, []);
      }
      seriesMap.get(series)?.push(artwork);
    }
  }

  for (const [series, collection] of seriesMap.entries()) {
    paths.push({
      params: { series: toPathSafeSlug(series) },
      props: {
        seriesName: series,
        artworks: collection.sort(
          (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
        ),
      },
    });
  }
  return paths;
}

const { artworks, seriesName } = Astro.props;
---
<BaseLayout title={`${seriesName} - ${t['nav.gallery']}`}>
  <div class="sidebar-page-shell">
   <div class="sidebar-page-grid">
    <HomeStyleSidebars lang={lang}>
      <div class="main-column">
        <div class="list-container">
          <h1>{seriesName}</h1>
          <section class="card-grid">
            {artworks.map((artwork, index) => (
              <ArtworkCard
                href={`/gallery/${artwork.slug.replace(`${lang}/`, "")}`}
                title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
                image={getHeaderImage(artwork)}
                slug={artwork.slug.replace(`${lang}/`, "")}
                eager={index < 8}
              />
            ))}
          </section>
        </div>
      </div>
    </HomeStyleSidebars>
   </div>
  </div>
</BaseLayout>
<style is:inline>
  .list-container { display: grid; }
  h1 { font-size: 2rem; font-weight: 500; margin-bottom: 1.5rem; color: var(--text-primary); }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.1rem;
  }
  @media (max-width: 768px) {
    h1 { font-size: 1.5rem; }
    .card-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.85rem; }
  }
</style>
