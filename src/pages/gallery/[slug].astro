---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import ArticleImageStack from "~/components/ArticleImageStack.astro";
import ArtworkCard from "~/components/ArtworkCard.astro";
import CommentSection from "~/components/CommentSection.astro";
import LikeButton from "~/components/LikeButton.astro";
import ShareButtons from "~/components/ShareButtons.astro";
import SidebarSection from "~/components/SidebarSection.astro";
import { patreonMembershipUrl } from "~/constants/social";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  getArtworkCharacters,
  getHeaderImage,
  getPortfolioImages,
  getPrimaryCharacter,
  getSampleImages,
} from "~/utils/artwork";
import { toPathSafeSlug } from "~/utils/slug";

const lang = "ja";
// 日本語ページとして固定

export async function getStaticPaths() {
  const artworks = await getCollection("artworks", ({ id }) =>
    id.startsWith("ja/"),
  );
  return artworks.map((artwork) => ({
    params: { slug: artwork.slug.replace(/^(ja)\//, "") },
    props: { artwork },
  }));
}

const { artwork } = Astro.props;
const { Content } = await artwork.render();
const t = ui[lang];

const allCharacters = getArtworkCharacters(artwork);
const primaryCharacter = getPrimaryCharacter(artwork);
const portfolioImages = getPortfolioImages(artwork);
const sampleImages = getSampleImages(artwork);
const hasBody = Boolean(artwork.body?.trim().length);

const pageUrl = new URL(
  `/gallery/${artwork.slug.replace(`${lang}/`, "")}`,
  Astro.site,
).toString();

const allArtworks = await getCollection("artworks", ({ id }) =>
  id.startsWith(`${lang}/`),
);

const relatedByCharacter = primaryCharacter
  ? allArtworks
      .filter(
        (a) =>
          a.slug !== artwork.slug &&
          getArtworkCharacters(a).includes(primaryCharacter),
      )
      .sort(
        (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
      )
      .slice(0, 6)
  : [];

const relatedBySeries = artwork.data.series
  ? allArtworks
      .filter(
        (a) => a.slug !== artwork.slug && a.data.series === artwork.data.series,
      )
      .sort(
        (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
      )
      .slice(0, 6)
  : [];

const recommendDoujinshi = (
  await getCollection("doujinshi", ({ id }) => id.startsWith(`${lang}/`))
).slice(0, 2);

const relatedArtworks = artwork.data.relatedImages
  ? await getCollection("artworks", ({ id, slug }) => {
      const artworkLang = id.split("/")[0];
      const artworkSlug = slug.replace(/^(ja)\//, "");
      return (
        artworkLang === lang &&
        artwork.data.relatedImages?.includes(artworkSlug)
      );
    })
  : [];
---
<BaseLayout title={artwork.data.title} description={artwork.data.description} keywords={artwork.data.keywords.join(', ')}>
  <div class="detail-shell">
    <article class="main-column">
      <h1>{artwork.data.title}</h1>

      <div class="hero-frame">
        <Image
          src={getHeaderImage(artwork)}
          alt={artwork.data.title}
          quality="max"
          format="webp"
          width={1200}
        />
      </div>

      <div class="artwork-meta">
        {allCharacters.length > 0 && (
          <div class="meta-characters">
            {allCharacters.map((char, index) => (
              <>
                <a href={`/gallery/character/${encodeURIComponent(toPathSafeSlug(char))}`}>
                  {char}
                </a>
                {index < allCharacters.length - 1 && ', '}
              </>
            ))}
          </div>
        )}

        {artwork.data.series && (
          <div class="meta-series">
            {allCharacters.length > 0 && ' / '}
            <a href={`/gallery/series/${encodeURIComponent(toPathSafeSlug(artwork.data.series))}`}>
              {artwork.data.series}
            </a>
          </div>
        )}
      </div>

      <div class="action-row">
        <LikeButton slug={artwork.slug.replace(`${lang}/`, "")} />
        <ShareButtons lang={lang} url={pageUrl} text={artwork.data.title} />
      </div>

      {hasBody && <div class="artwork-body"><Content /></div>}

      <ArticleImageStack images={portfolioImages} groupId="portfolio" eagerCount={2} />

      {sampleImages.length > 0 && (
        <div class="membership-transition">
          <p><i class="ti ti-lock" aria-hidden="true"></i> {t["artwork.membershipTransition"]}</p>
          <p class="membership-unfiltered">{t["artwork.membershipUnfiltered"]}</p>
        </div>
      )}

      {sampleImages.length > 0 && (
        <ArticleImageStack images={sampleImages} groupId="sample" eagerCount={0} />
      )}

      <a href={patreonMembershipUrl} target="_blank" rel="noopener noreferrer" class="membership-cta">
        <span class="membership-cta-text">
          <strong>{t["artwork.membershipCta"]}</strong>
          <i class="ti ti-external-link" aria-hidden="true"></i>
        </span>
      </a>
      <a href="/membership" class="membership-more-link">{t["artwork.membershipMoreLink"]}</a>

      {relatedArtworks.length > 0 && (
        <div class="related-works">
          <h2>{t['artwork.related']}</h2>
          <div class="thumbnail-grid">
            {relatedArtworks.map((related) => (
              <ArtworkCard
                href={`/gallery/${related.slug.replace(`${lang}/`, '')}`}
                title={related.data.title}
                image={getHeaderImage(related)}
                slug={related.slug.replace(`${lang}/`, '')}
              />
            ))}
          </div>
        </div>
      )}
    </article>

    <aside class="sidebar-column">
      {primaryCharacter && relatedByCharacter.length > 0 && (
        <SidebarSection
          title={`${primaryCharacter}${t["sidebar.moreByCharacter"]}`}
          href={`/gallery/character/${encodeURIComponent(toPathSafeSlug(primaryCharacter))}`}
        >
          {relatedByCharacter.map((related) => (
            <ArtworkCard
              href={`/gallery/${related.slug.replace(`${lang}/`, '')}`}
              title={related.data.title}
              image={getHeaderImage(related)}
              slug={related.slug.replace(`${lang}/`, '')}
            />
          ))}
        </SidebarSection>
      )}

      {artwork.data.series && relatedBySeries.length > 0 && (
        <SidebarSection
          title={`${artwork.data.series}${t["sidebar.moreBySeries"]}`}
          href={`/gallery/series/${encodeURIComponent(toPathSafeSlug(artwork.data.series))}`}
        >
          {relatedBySeries.map((related) => (
            <ArtworkCard
              href={`/gallery/${related.slug.replace(`${lang}/`, '')}`}
              title={related.data.title}
              image={getHeaderImage(related)}
              slug={related.slug.replace(`${lang}/`, '')}
            />
          ))}
        </SidebarSection>
      )}

      {recommendDoujinshi.length > 0 && (
        <SidebarSection title={t["sidebar.recommend"]} href="/recommend">
          {recommendDoujinshi.map((item) => (
            <a class="recommend-card" href={`/doujinshi/${item.slug.replace(`${lang}/`, '')}`}>
              <Image src={item.data.packageImage} alt={item.data.title} format="webp" width={240} />
            </a>
          ))}
        </SidebarSection>
      )}
    </aside>

    <div class="comments-wrapper">
      <CommentSection slug={artwork.slug.replace(`${lang}/`, "")} lang={lang} />
    </div>
  </div>
</BaseLayout>
<style is:inline>
  .detail-shell {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }

  .main-column {
    display: grid;
    gap: 1.6rem;
    min-width: 0;
  }

  .sidebar-column {
    display: grid;
    gap: 1.75rem;
    min-width: 0;
    position: sticky;
    top: 96px;
  }

  .comments-wrapper {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
  }

  .hero-frame {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-elevated);
  }
  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  h1 { font-size: 2.0rem; margin: 0; color: var(--text-primary); }
  .artwork-body { line-height: 1.85; color: var(--text-secondary); }

  .artwork-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 1.05rem;
    color: var(--text-secondary);
  }
  .meta-characters, .meta-series { display: inline; }
  .artwork-meta a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }
  .artwork-meta a:hover { color: var(--text-primary); }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .membership-transition {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    border: 0.5px solid var(--accent);
    color: var(--text-primary);
  }
  .membership-transition p { margin: 0; font-size: 0.92rem; font-weight: 600; }
  .membership-transition i { color: var(--heart); font-size: 16px; }
  .membership-unfiltered { color: var(--text-secondary); font-weight: 500 !important; font-size: 0.85rem !important; }

  .membership-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .membership-cta:hover,
  .membership-cta:focus-visible {
    transform: scale(1.01);
  }
  .membership-cta-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    font-size: 1.15rem;
  }
  .membership-cta-text i { font-size: 18px; }

  .membership-more-link {
    justify-self: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .membership-more-link:hover { color: var(--text-primary); }

  .related-works { margin-top: 0.5rem; }
  .related-works h2 { font-size: 1.3rem; margin-bottom: 1rem; color: var(--text-primary); font-weight: 500; border-bottom: 0.5px solid var(--border-subtle); padding-bottom: 0.5rem; }
  .thumbnail-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 1rem; }

  .recommend-card {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--bg-elevated-2);
  }
  .recommend-card img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 960px) {
    .detail-shell { grid-template-columns: 1fr; }
    .sidebar-column { position: static; }
  }

  @media (max-width: 768px) {
    .detail-shell { padding: 1rem; gap: 1.25rem; }
    h1 { font-size: 1.6rem; }
    .related-works h2 { font-size: 1.15rem; }
    .membership-cta-text { font-size: 1rem; }
  }
</style>
