---
import { getCollection } from "astro:content";
import ArtworkCard from "~/components/ArtworkCard.astro";
import Rail from "~/components/Rail.astro";
import {
  membershipComparisonRows,
  membershipFaq,
  membershipFeatureHighlights,
} from "~/constants/membershipContent";
import { membershipTiers } from "~/constants/membershipTiers";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  formatImageCountLabel,
  getHeaderImage,
  getTotalImageCount,
} from "~/utils/artwork";

const lang = "ja";
const t = ui[lang];
const partnerTier = membershipTiers[membershipTiers.length - 1];

function toSlug(fullSlug: string) {
  return fullSlug.replace(`${lang}/`, "");
}
function toHref(fullSlug: string) {
  return `/gallery/${toSlug(fullSlug)}`;
}
function toDoujinshiHref(fullSlug: string) {
  return `/doujinshi/${toSlug(fullSlug)}`;
}

const artworks = await getCollection("artworks", ({ id }) =>
  id.startsWith(`${lang}/`),
);
const latestArtworks = [...artworks]
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 10);

const doujinshiList = await getCollection("doujinshi", ({ id }) =>
  id.startsWith(`${lang}/`),
);
const latestDoujinshi = [...doujinshiList]
  .filter((item) => item.data.isOwnWork !== false)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 10);
---

<BaseLayout title={t["membership.pageTitle"]} description={t["membership.pageDescription"]} noAds>
  <div class="membership-lp">
    <section class="mship-hero" id="hero">
      <div class="hero-banner" aria-hidden="true">
        <img src="/images/patreon-banner.png" alt="" width="3000" height="1000" loading="eager" />
      </div>
      <div class="mship-container hero-grid">
        <div class="hero-copy">
          <p class="hero-eyebrow">FAN CLUB MEMBERSHIP</p>
          <h1>{t["membership.heroCatch"]}</h1>
          <p class="hero-sub">{t["membership.heroSub"]}</p>
          <a href="#pricing" class="hero-cta">
            {t["membership.heroCta"]} <i class="ti ti-arrow-narrow-down" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>

    <section class="mship-features" id="features">
      <div class="mship-container">
        <h2>{t["membership.featuresHeading"]}</h2>
        <div class="features-carousel">
          <div class="features-track" id="features-track" role="region" aria-roledescription="carousel" aria-label={t["membership.featuresHeading"]}>
            {membershipFeatureHighlights.map((feature) => (
              <div class="feature-slide">
                <div class="feature-card">
                  <span class="feature-icon" aria-hidden="true">{feature.icon}</span>
                  <span class="feature-tag">{feature.availability[lang]}</span>
                  <h3>{feature.title[lang]}</h3>
                  <p>{feature.desc[lang]}</p>
                </div>
              </div>
            ))}
          </div>
          <div
            class="features-dots"
            id="features-dots"
            role="tablist"
            data-nav-label={t["membership.carouselDotsNavLabel"]}
            data-page-label={t["membership.carouselPageLabel"]}
          >
          </div>
        </div>
      </div>
    </section>

    <section class="mship-pricing" id="pricing">
      <div class="mship-container">
        <h2>{t["membership.pricingHeading"]}</h2>
        <p class="pricing-lead">{t["membership.pricingLead"]}</p>
        <div class="tier-grid">
          {membershipTiers.map((tier) => (
            <div class:list={["tier-card", { "tier-premium": tier.popular }]}>
              {tier.popular && tier.badge && <span class="tier-badge">{tier.badge[lang]}</span>}
              <div class="tier-head">
                <img class="tier-thumb" src={tier.thumbnail} alt={tier.name[lang]} width="1280" height="560" loading="lazy" />
                <h3>{tier.name[lang]}</h3>
                <p class="tier-tagline">{tier.tagline[lang]}</p>
              </div>
              <p class="tier-price">
                <span class="amount">{tier.price[lang]}</span>
                <span class="period">{tier.period[lang]}</span>
              </p>
              <ul class="tier-features">
                {tier.features.map((feature) => (
                  <li>{feature.text[lang]}</li>
                ))}
              </ul>
              <a
                href={tier.patreonTierUrl}
                target="_blank"
                rel="noopener noreferrer"
                class:list={["tier-cta", { "tier-cta-premium": tier.popular }]}
                data-ga-event="membership_cta_click"
                data-ga-source="pricing_tier"
                data-ga-tier={tier.id}
              >
                {t["membership.tierCta"]} <i class="ti ti-external-link" aria-hidden="true"></i>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mship-highlights" id="highlights">
      <div class="mship-container">
        <h2>{t["membership.highlightsHeading"]}</h2>
        <div class="highlight-list">
          <div class="highlight-item">
            <div class="highlight-visual">
              <img src="/images/placeholder-membership-top-1.jpg" alt={t["membership.highlightOrderTitle"]} width="320" height="210" loading="lazy" />
            </div>
            <div class="highlight-copy">
              <span class="highlight-tag">{t["membership.highlightOrderTag"]}</span>
              <h3>{t["membership.highlightOrderTitle"]}</h3>
              <p>{t["membership.highlightOrderBody"]}</p>
              <p class="highlight-note">{t["membership.highlightOrderNote"]}</p>
            </div>
          </div>

          <div class="highlight-item highlight-item-wide">
            <div class="highlight-copy">
              <span class="highlight-tag">{t["membership.highlightArchiveTag"]}</span>
              <h3>{t["membership.highlightArchiveTitle"]}</h3>
              <p>{t["membership.highlightArchiveBody"]}</p>
            </div>
            {latestArtworks.length > 0 && (
              <Rail title="" seeMoreHref="/" seeMoreLabel={t["membership.highlightArchiveCta"]}>
                {latestArtworks.map((artwork, index) => (
                  <ArtworkCard
                    href={toHref(artwork.slug)}
                    title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
                    image={getHeaderImage(artwork)}
                    slug={toSlug(artwork.slug)}
                    thumbWidth={340}
                    eager={index < 4}
                  />
                ))}
              </Rail>
            )}
          </div>

          <div class="highlight-item highlight-item-wide">
            <div class="highlight-copy">
              <span class="highlight-tag">{t["membership.highlightShopTag"]}</span>
              <h3>{t["membership.highlightShopTitle"]}</h3>
              <p>{t["membership.highlightShopBody"]}</p>
            </div>
            {latestDoujinshi.length > 0 && (
              <Rail title="" seeMoreHref="/doujinshi" seeMoreLabel={t["membership.highlightShopCta"]}>
                {latestDoujinshi.map((item) => (
                  <ArtworkCard
                    href={toDoujinshiHref(item.slug)}
                    title={item.data.title}
                    image={item.data.packageImage}
                    aspect="4/3"
                    fit="contain"
                    thumbWidth={340}
                    slug={toSlug(item.slug)}
                  />
                ))}
              </Rail>
            )}
          </div>
        </div>
      </div>
    </section>

    <section class="mship-compare" id="compare">
      <div class="mship-container">
        <h2>{t["membership.compareHeading"]}</h2>
        <p class="compare-lead">{t["membership.compareLead"]}</p>
        <div class="compare-table-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th scope="col"></th>
                {membershipTiers.map((tier) => (
                  <th scope="col" class:list={{ "is-popular": tier.popular }}>{tier.name[lang]}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {membershipComparisonRows.map((row) => (
                <tr>
                  <th scope="row">{row.label[lang]}</th>
                  {row.included.map((yes, i) => (
                    <td class:list={{ "is-yes": yes, "is-no": !yes, "is-popular": membershipTiers[i].popular }}>
                      <span aria-hidden="true">{yes ? "○" : "✕"}</span>
                      <span class="sr-only">
                        {yes ? t["membership.includedLabel"] : t["membership.notIncludedLabel"]}
                      </span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="mship-faq" id="faq">
      <div class="mship-container">
        <h2>{t["membership.faqHeading"]}</h2>
        <div class="faq-list">
          {membershipFaq.map((item, index) => (
            <div class="faq-item">
              <button type="button" class="faq-question" aria-expanded="false" aria-controls={`faq-answer-${index}`}>
                <span>{item.question[lang]}</span>
                <i class="ti ti-chevron-down" aria-hidden="true"></i>
              </button>
              <div class="faq-answer" id={`faq-answer-${index}`}>
                <p>{item.answer[lang]}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mship-footer-cta">
      <div class="mship-container">
        <h2>{t["membership.footerCatch"]}</h2>
        <a
          href={partnerTier.patreonTierUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-cta-button"
          data-ga-event="membership_cta_click"
          data-ga-source="footer_cta"
          data-ga-tier={partnerTier.id}
        >
          {t["membership.footerCta"]}
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".faq-question").forEach((button) => {
    button.addEventListener("click", () => {
      const isOpen = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", isOpen ? "false" : "true");
      const answer = document.getElementById(button.getAttribute("aria-controls") ?? "");
      answer?.classList.toggle("is-open", !isOpen);
    });
  });

  // 特典カードの自動カルーセル（PC:3枚 / タブレット:2枚 / モバイル:1枚ずつ表示）
  (function setupFeaturesCarousel() {
    const track = document.getElementById("features-track");
    const dotsContainer = document.getElementById("features-dots");
    if (!track || !dotsContainer) return;

    const slideCount = track.children.length;
    const pageLabel = dotsContainer.dataset.pageLabel ?? "Page";
    const navLabel = dotsContainer.dataset.navLabel ?? "";
    dotsContainer.setAttribute("aria-label", navLabel);

    const AUTO_INTERVAL_MS = 4500;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let cardsPerView = 3;
    let totalPages = 1;
    let currentPage = 0;
    let autoTimer: ReturnType<typeof setInterval> | null = null;

    function computeCardsPerView() {
      const w = window.innerWidth;
      if (w <= 640) return 1;
      if (w <= 960) return 2;
      return 3;
    }

    function updateDots() {
      Array.from(dotsContainer!.children).forEach((dot, i) => {
        dot.classList.toggle("is-active", i === currentPage);
        dot.setAttribute("aria-selected", i === currentPage ? "true" : "false");
      });
    }

    function goToPage(index: number) {
      currentPage = Math.max(0, Math.min(index, totalPages - 1));
      track!.scrollTo({ left: currentPage * track!.clientWidth, behavior: "smooth" });
      updateDots();
    }

    function buildDots() {
      dotsContainer!.innerHTML = "";
      for (let i = 0; i < totalPages; i++) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.setAttribute("role", "tab");
        dot.setAttribute("aria-label", `${pageLabel} ${i + 1}`);
        dot.addEventListener("click", () => {
          goToPage(i);
          restartAutoplay();
        });
        dotsContainer!.appendChild(dot);
      }
      updateDots();
    }

    function recompute() {
      cardsPerView = computeCardsPerView();
      totalPages = Math.max(1, Math.ceil(slideCount / cardsPerView));
      if (currentPage > totalPages - 1) currentPage = totalPages - 1;
      buildDots();
    }

    function stopAutoplay() {
      if (autoTimer !== null) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    function startAutoplay() {
      if (prefersReducedMotion || totalPages <= 1) return;
      stopAutoplay();
      autoTimer = setInterval(() => {
        goToPage((currentPage + 1) % totalPages);
      }, AUTO_INTERVAL_MS);
    }

    function restartAutoplay() {
      stopAutoplay();
      startAutoplay();
    }

    let scrollDebounce: ReturnType<typeof setTimeout>;
    track.addEventListener("scroll", () => {
      clearTimeout(scrollDebounce);
      scrollDebounce = setTimeout(() => {
        const page = Math.round(track!.scrollLeft / track!.clientWidth);
        const clamped = Math.max(0, Math.min(page, totalPages - 1));
        if (clamped !== currentPage) {
          currentPage = clamped;
          updateDots();
        }
      }, 100);
    });

    track.addEventListener("pointerenter", stopAutoplay);
    track.addEventListener("pointerleave", startAutoplay);
    track.addEventListener("touchstart", stopAutoplay, { passive: true });

    let resizeDebounce: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeDebounce);
      resizeDebounce = setTimeout(() => {
        recompute();
        goToPage(currentPage);
      }, 150);
    });

    recompute();
    startAutoplay();
  })();
</script>

<style is:inline>
  .membership-lp {
    --gold: #e8c37a;
    --gold-strong: #f3d99a;
    --pink: #d874a0;
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    padding-bottom: 1rem;
  }

  /* grid/flexアイテムはデフォルトでmin-width:autoとなり、中の長い文字列（改行禁止設定など）が
     祖先ごとページ全体を押し広げてしまうことがあるため、明示的に0にリセットする */
  .membership-lp > section,
  .hero-grid,
  .hero-copy,
  .hero-copy > * {
    min-width: 0;
  }

  .mship-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .membership-lp section h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text-primary);
    text-align: center;
  }

  /* ---------- Hero ---------- */
  .mship-hero {
    position: relative;
    min-height: clamp(320px, 42vw, 460px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: linear-gradient(160deg, var(--bg-elevated) 0%, var(--bg-page) 100%);
    border-bottom: 0.5px solid var(--border-subtle);
  }

  .hero-banner {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-banner img {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: cover;
    opacity: 0.96;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 46%);
    mask-image: linear-gradient(to right, transparent 0%, black 46%);
  }

  .hero-banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      var(--bg-page) 0%,
      var(--bg-page) 32%,
      rgb(23 20 28 / 75%) 46%,
      rgb(122 74 150 / 28%) 62%,
      rgb(232 195 122 / 12%) 100%
    );
    mix-blend-mode: multiply;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
  }

  .hero-copy {
    max-width: 600px;
    display: grid;
    gap: 1.1rem;
    padding: clamp(2rem, 5vw, 3rem) 0;
  }

  .hero-eyebrow {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    color: var(--gold);
    text-shadow: 0 2px 10px rgb(0 0 0 / 80%);
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    line-height: 1.45;
    font-weight: 600;
    color: var(--text-primary);
    text-shadow: 0 2px 8px rgb(0 0 0 / 90%), 0 10px 36px rgb(0 0 0 / 70%);
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .hero-sub {
    margin: 0;
    max-width: 50ch;
    color: var(--text-secondary);
    line-height: 1.85;
    font-size: 0.96rem;
    text-shadow: 0 1px 6px rgb(0 0 0 / 85%), 0 6px 24px rgb(0 0 0 / 60%);
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .hero-cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    padding: 0.85rem 1.8rem;
    border-radius: 999px;
    background: linear-gradient(120deg, var(--accent-strong), var(--pink));
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 8px 24px rgb(155 99 214 / 35%);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgb(155 99 214 / 45%);
  }

  /* ---------- Features carousel ---------- */
  .features-carousel {
    margin-top: 2rem;
  }

  .features-track {
    display: flex;
    gap: 1.1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* smoothはCSSではなくJS側のscrollTo({behavior:"smooth"})で制御する。
       CSSのscroll-behavior:smoothをここで併用すると、一部環境でscrollLeftの
       プログラム制御（自動再生・ドット操作）が効かなくなることがあるため外す */
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* overflow-x:autoの内部スクロール幅がページ全体のレイアウトビューポート
       （固定ヘッダーの100%幅の基準）まで広げてしまうのを防ぐ */
    contain: paint;
  }

  .features-track::-webkit-scrollbar {
    display: none;
  }

  .feature-slide {
    flex: 0 0 auto;
    width: calc((100% - 2 * 1.1rem) / 3);
    scroll-snap-align: start;
  }

  .feature-card {
    position: relative;
    height: 100%;
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.5rem 1.3rem;
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 0.5px solid var(--border-subtle);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-strong);
  }

  .feature-icon {
    font-size: 1.8rem;
    line-height: 1;
  }

  .feature-tag {
    justify-self: start;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent-strong);
    background: var(--accent-soft);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .feature-card h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .feature-card p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .features-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .features-dots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--border-strong);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .features-dots button:hover {
    background: var(--text-secondary);
  }

  .features-dots button.is-active {
    background: var(--accent-strong);
    transform: scale(1.3);
  }

  @media (width <= 960px) {
    .feature-slide {
      width: calc((100% - 1.1rem) / 2);
    }
  }

  @media (width <= 640px) {
    .feature-slide {
      width: 100%;
    }
  }

  /* ---------- Pricing ---------- */
  .mship-pricing {
    padding: 1rem 1.25rem;
    scroll-margin-top: 90px;
  }

  .pricing-lead {
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .tier-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    margin-top: 2.5rem;
  }

  .tier-card {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1.75rem 1.5rem 2rem;
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 0.5px solid var(--border-subtle);
    transition: transform 0.25s ease;
  }

  .tier-premium {
    border: 2px solid transparent;
    background:
      linear-gradient(var(--bg-elevated), var(--bg-elevated)) padding-box,
      linear-gradient(150deg, var(--gold), var(--pink), var(--accent-strong)) border-box;
    box-shadow: 0 18px 44px rgb(232 195 122 / 20%);
    transform: scale(1.04);
    z-index: 1;
  }

  .tier-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background: linear-gradient(120deg, var(--gold), var(--pink));
    color: #241a10;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 4px 16px;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgb(0 0 0 / 30%);
  }

  .tier-head {
    display: grid;
    gap: 0.6rem;
  }

  .tier-thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 1280 / 560;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .tier-head h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .tier-tagline {
    margin: 0.2rem 0 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .tier-price {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .tier-price .amount {
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .tier-premium .tier-price .amount {
    color: var(--gold-strong);
  }

  .tier-price .period {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .tier-features {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }

  .tier-features li {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
