---
import AdsenseAd from "~/components/AdsenseAd.astro";
import DualImageComposer from "~/components/DualImageComposer.astro";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

const lang = "ja";
const t = ui[lang];
const appJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: t["tool.pageTitle"],
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Web",
  inLanguage: "ja",
  url: new URL("/tools/tap-change-image", Astro.site).toString(),
  description: t["tool.pageDescription"],
};
---

<BaseLayout
  title={t["tool.pageTitle"]}
  description={t["tool.pageDescription"]}
  keywords="PNG, 透過画像, 合成ツール, 白背景, 黒背景, X投稿, タップ変化"
  image={{ src: "/images/tap_change_image_chan.jpg", alt: t["tool.pageTitle"] }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />

  <DualImageComposer
    bannerSrc="/images/tap_change_image_chan.jpg"
    bannerAlt={t["tool.pageTitle"]}
    shareUrl={new URL("/tools/tap-change-image", Astro.site).toString()}
    copy={{
      title: t["tool.pageTitle"],
      lead: t["tool.lead"],
      whiteInput: t["tool.whiteInput"],
      blackInput: t["tool.blackInput"],
      dropHint: t["tool.dropHint"],
      chooseButton: t["tool.chooseButton"],
      fileHint: t["tool.fileHint"],
      resizeX: t["tool.resizeX"],
      generate: t["tool.generate"],
      download: t["tool.download"],
      previewWhite: t["tool.previewWhite"],
      previewBlack: t["tool.previewBlack"],
      statusIdle: t["tool.statusIdle"],
      statusNeedBoth: t["tool.statusNeedBoth"],
      statusWorking: t["tool.statusWorking"],
      statusReady: t["tool.statusReady"],
      statusError: t["tool.statusError"],
      contactLabel: t["tool.contactLabel"],
      contactLinkText: t["tool.contactLinkText"],
      noteApproximation: t["tool.noteApproximation"],
      noteResize: t["tool.noteResize"],
      contactHref: "/profile",
      shareButton: t["tool.shareButton"],
      shareText: t["tool.shareText"],
    }}
  />
  <AdsenseAd adSlot="8596977871" />
</BaseLayout>
