---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

const lang = "ja";
const t = ui[lang];

const items = await getCollection("doujinshi", ({ id }) =>
  id.startsWith(`${lang}/`),
);
const sorted = [...items].sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---
<BaseLayout title={t["doujinshi.pageTitle"]} description={t["doujinshi.pageDescription"]}>
  <div class="doujinshi-shell">
    <header class="doujinshi-header">
      <h1>{t["doujinshi.heading"]}</h1>
      <p>{t["doujinshi.lead"]}</p>
    </header>

    <div class="doujinshi-grid">
      {sorted.map((item) => (
        <a class="doujinshi-card" href={`/doujinshi/${item.slug.replace(`${lang}/`, "")}`}>
          <div class="package-frame">
            <Image src={item.data.packageImage} alt={item.data.title} format="webp" width={400} />
          </div>
          <div class="card-body">
            <h2>{item.data.title}</h2>
            <p>{item.data.description}</p>
            <span class="card-cta">{t["doujinshi.viewButton"]} <i class="ti ti-arrow-right" aria-hidden="true"></i></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style is:inline>
  .doujinshi-shell {
    max-width: 1040px;
    margin: 0 auto;
    padding: 1.25rem;
    display: grid;
    gap: 1.5rem;
  }

  .doujinshi-header h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.7rem, 3.4vw, 2.35rem);
    color: var(--text-primary);
  }

  .doujinshi-header p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 65ch;
  }

  .doujinshi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .doujinshi-card {
    display: grid;
    gap: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 0.5px solid var(--border-subtle);
    background: var(--bg-elevated);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }

  .doujinshi-card:hover,
  .doujinshi-card:focus-visible {
    border-color: var(--accent-strong);
  }

  .package-frame {
    aspect-ratio: 4 / 3;
    background: var(--bg-elevated-2);
  }

  .package-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 1.1rem 1.2rem 1.3rem;
    display: grid;
    gap: 0.5rem;
  }

  .card-body h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .card-body p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  @media (width <= 768px) {
    .doujinshi-shell { padding: 1rem; gap: 1.25rem; }
    .doujinshi-grid { grid-template-columns: 1fr; }
  }
</style>
