---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import AffiliateColumn from "~/components/AffiliateColumn.astro";
import ArticleImageStack from "~/components/ArticleImageStack.astro";
import ArtworkCard from "~/components/ArtworkCard.astro";
import LikeButton from "~/components/LikeButton.astro";
import ShareButtons from "~/components/ShareButtons.astro";
import SidebarSection from "~/components/SidebarSection.astro";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  formatImageCountLabel,
  getHeaderImage,
  getTotalImageCount,
} from "~/utils/artwork";
import { toPathSafeSlug } from "~/utils/slug";

const lang = "ja";
const t = ui[lang];

export async function getStaticPaths() {
  const items = await getCollection("doujinshi", ({ id }) =>
    id.startsWith("ja/"),
  );
  return items.map((item) => ({
    params: { slug: item.slug.replace(/^ja\//, "") },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const itemSlug = item.slug.replace(`${lang}/`, "");

const pageUrl = new URL(`/doujinshi/${itemSlug}`, Astro.site).toString();

const compiledFrom = item.data.compiledFrom
  ? await getCollection("doujinshi", ({ id, slug }) => {
      const itemLang = id.split("/")[0];
      const otherSlug = slug.replace(/^ja\//, "");
      return itemLang === lang && item.data.compiledFrom?.includes(otherSlug);
    })
  : [];

const otherDoujinshi = (
  await getCollection("doujinshi", ({ id }) => id.startsWith(`${lang}/`))
)
  .filter((d) => d.slug !== item.slug)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6);

const sameSeriesArtworks = item.data.series
  ? (await getCollection("artworks", ({ id }) => id.startsWith(`${lang}/`)))
      .filter((a) => a.data.series === item.data.series)
      .sort(
        (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
      )
      .slice(0, 6)
  : [];
---
<BaseLayout title={item.data.title} description={item.data.description}>
  <div class="detail-shell">
   <div class="detail-grid">
    <AffiliateColumn lang={lang} />

    <article class="main-column">
      <a class="back-link" href="/doujinshi">{t["doujinshi.backToList"]}</a>

      <h1>{item.data.title}</h1>

      <div class="hero-frame">
        <Image src={item.data.packageImage} alt={item.data.title} format="webp" width={640} />
      </div>

      {item.data.characters && item.data.characters.length > 0 && (
        <div class="lp-characters">
          {item.data.characters.map((char) => (
            <a class="character-tag" href={`/gallery/character/${encodeURIComponent(toPathSafeSlug(char))}`}>{char}</a>
          ))}
        </div>
      )}

      <div class="action-row">
        <LikeButton slug={`doujinshi-${itemSlug}`} />
        <ShareButtons lang={lang} url={pageUrl} text={item.data.title} />
      </div>

      <div class="lp-body"><Content /></div>

      {item.data.sampleImages && item.data.sampleImages.length > 0 && (
        <section class="lp-samples">
          <h2>{t["doujinshi.sampleHeading"]}</h2>
          <ArticleImageStack images={item.data.sampleImages} groupId="doujinshi-samples" eagerCount={1} />
        </section>
      )}

      {compiledFrom.length > 0 && (
        <section class="lp-compiled">
          <h2>{t["doujinshi.compiledHeading"]}</h2>
          <div class="doujinshi-grid">
            {compiledFrom.map((included) => (
              <a class="doujinshi-card" href={`/doujinshi/${included.slug.replace(`${lang}/`, '')}`}>
                <div class="package-frame">
                  <Image src={included.data.packageImage} alt={included.data.title} format="webp" width={400} />
                </div>
                <div class="card-body">
                  <h2>{included.data.title}</h2>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="lp-details">
        <h2>{t["doujinshi.detailsHeading"]}</h2>
        <table class="details-table">
          <tbody>
            <tr>
              <th>{t["doujinshi.detailsTitle"]}</th>
              <td>{item.data.title}</td>
            </tr>
            {item.data.author && (
              <tr>
                <th>{t["doujinshi.detailsAuthor"]}</th>
                <td>{item.data.author}</td>
              </tr>
            )}
            {item.data.pageCount && (
              <tr>
                <th>{t["doujinshi.detailsPageCount"]}</th>
                <td>{item.data.pageCount} ページ</td>
              </tr>
            )}
          </tbody>
        </table>
      </section>

      <section class="lp-buy">
        <h2>{t["doujinshi.buyHeading"]}</h2>
        <div class="buy-buttons">
          {item.data.fanzaUrl && (
            <a href={item.data.fanzaUrl} target="_blank" rel="noopener noreferrer sponsored" class="buy-btn buy-fanza">
              {t["doujinshi.fanzaButton"]} <i class="ti ti-external-link" aria-hidden="true"></i>
            </a>
          )}
          {item.data.patreonUrl && (
            <a href={item.data.patreonUrl} target="_blank" rel="noopener noreferrer" class="buy-btn buy-patreon">
              {t["doujinshi.patreonButton"]} <i class="ti ti-external-link" aria-hidden="true"></i>
            </a>
          )}
          {item.data.dlsiteUrl && (
            <a href={item.data.dlsiteUrl} target="_blank" rel="noopener noreferrer sponsored" class="buy-btn buy-dlsite">
              {t["doujinshi.dlsiteButton"]} <i class="ti ti-external-link" aria-hidden="true"></i>
            </a>
          )}
          {item.data.digiketUrl && (
            <a href={item.data.digiketUrl} target="_blank" rel="noopener noreferrer sponsored" class="buy-btn buy-digiket">
              {t["doujinshi.digiketButton"]} <i class="ti ti-external-link" aria-hidden="true"></i>
            </a>
          )}
        </div>
      </section>

      <div class="action-row action-row-bottom">
        <LikeButton slug={`doujinshi-${itemSlug}`} />
        <ShareButtons lang={lang} url={pageUrl} text={item.data.title} />
      </div>
    </article>

    <aside class="sidebar-column sidebar-column-right">
      {otherDoujinshi.length > 0 && (
        <SidebarSection title={t["doujinshi.heading"]} href="/doujinshi">
          {otherDoujinshi.map((other) => (
            <a class="recommend-card" href={`/doujinshi/${other.slug.replace(`${lang}/`, '')}`}>
              <Image src={other.data.packageImage} alt={other.data.title} format="webp" width={240} />
            </a>
          ))}
        </SidebarSection>
      )}

      {sameSeriesArtworks.length > 0 && (
        <SidebarSection
          title={`${item.data.series}${t["sidebar.moreBySeries"]}`}
          href={`/gallery/series/${encodeURIComponent(toPathSafeSlug(item.data.series ?? ""))}`}
        >
          {sameSeriesArtworks.map((artwork) => (
            <ArtworkCard
              href={`/gallery/${artwork.slug.replace(`${lang}/`, '')}`}
              title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
              image={getHeaderImage(artwork)}
              slug={artwork.slug.replace(`${lang}/`, '')}
            />
          ))}
        </SidebarSection>
      )}

    </aside>
   </div>
  </div>
</BaseLayout>

<style is:inline>
  .detail-shell {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    display: grid;
    gap: 2rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }

  .main-column {
    display: grid;
    gap: 1.6rem;
    min-width: 0;
  }

  .sidebar-column {
    display: grid;
    gap: 1.75rem;
    min-width: 0;
    position: sticky;
    top: 96px;
  }

  /* 左のアフィリエイト欄は、メインコンテンツ幅を圧迫しない十分な余白がある画面幅でのみ表示する */
  .sidebar-column-left {
    display: none;
  }

  @media (min-width: 1480px) {
    .detail-shell {
      max-width: 1520px;
    }
    .detail-grid {
      grid-template-columns: 280px 1fr 300px;
    }
    .sidebar-column-left {
      display: grid;
    }
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .back-link:hover { color: var(--text-primary); }

  h1 { margin: 0; font-size: 2.0rem; color: var(--text-primary); }

  .hero-frame {
    max-width: 480px;
    max-height: 640px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-elevated);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-frame img {
    max-width: 100%;
    max-height: 640px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .lp-characters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .character-tag {
    font-size: 0.82rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 0.5px solid var(--border-strong);
    color: var(--text-secondary);
    text-decoration: none;
  }
  .character-tag:hover { border-color: var(--accent-strong); color: var(--text-primary); }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .action-row-bottom {
    padding-top: 1.6rem;
    border-top: 0.5px solid var(--border-subtle);
  }

  .lp-body { line-height: 1.85; color: var(--text-secondary); }

  .lp-samples h2,
  .lp-details h2,
  .lp-buy h2,
  .lp-compiled h2 {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .lp-details {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 0.5px solid var(--border-subtle);
  }

  .details-table {
    width: 100%;
    border-collapse: collapse;
  }
  .details-table th,
  .details-table td {
    text-align: left;
    padding: 0.5rem 0.75rem;
    font-size: 0.92rem;
    border-bottom: 0.5px solid var(--border-subtle);
  }
  .details-table th {
    width: 30%;
    color: var(--text-secondary);
    font-weight: 500;
    white-space: nowrap;
  }
  .details-table td {
    color: var(--text-primary);
  }
  .details-table tr:last-child th,
  .details-table tr:last-child td {
    border-bottom: none;
  }

  .lp-buy {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
    border: 0.5px solid var(--accent);
  }

  .buy-buttons {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .buy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .buy-fanza {
    background: var(--bg-elevated);
    color: var(--text-primary);
    border: 0.5px solid var(--border-strong);
  }
  .buy-fanza:hover { border-color: var(--accent-strong); }

  .buy-patreon {
    background: var(--accent);
    color: #fff;
  }
  .buy-patreon:hover { background: var(--accent-strong); }

  .buy-dlsite,
  .buy-digiket {
    background: var(--bg-elevated);
    color: var(--text-primary);
    border: 0.5px solid var(--border-strong);
  }
  .buy-dlsite:hover,
  .buy-digiket:hover { border-color: var(--accent-strong); }

  .doujinshi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .doujinshi-card {
    display: grid;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 0.5px solid var(--border-subtle);
    background: var(--bg-elevated);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }
  .doujinshi-card:hover { border-color: var(--accent-strong); }
  .lp-compiled .card-body { padding: 0.75rem 0.9rem; }
  .lp-compiled .card-body h2 { margin: 0; font-size: 0.9rem; font-weight: 500; }

  .lp-compiled .package-frame {
    aspect-ratio: 4 / 3;
    background: var(--bg-elevated-2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lp-compiled .package-frame img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .recommend-card {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--bg-elevated-2);
  }
  .recommend-card img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }

  @media (max-width: 960px) {
    .detail-grid { grid-template-columns: 1fr; }
    .sidebar-column { position: static; }
  }

  @media (width <= 768px) {
    .detail-shell { padding: 1rem; gap: 1.25rem; }
    h1 { font-size: 1.6rem; }
    .hero-frame { max-width: 100%; }
  }
</style>
