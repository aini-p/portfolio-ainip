---
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

const lang = "en";
const t = ui[lang];
const tapToolPath = "/en/tools/tap-change-image";
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t["tools.pageTitle"],
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t["tools.card.tapTitle"],
      url: new URL(tapToolPath, Astro.site).toString(),
    },
  ],
};
---

<BaseLayout
  title={t["tools.pageTitle"]}
  description={t["tools.pageDescription"]}
  keywords="creator support tools, web tools, image tools, png, illustration, free browser tools"
  image={{ src: "/images/tap_change_image_chan_twcard.jpg", alt: t["tools.card.tapTitle"] }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />

  <section class="tools-shell">
    <header class="tools-header">
      <h1>{t["tools.heading"]}</h1>
      <p>{t["tools.lead"]}</p>
    </header>

    <ul class="tools-grid">
      <li>
        <a class="tool-card" href={tapToolPath}>
          <img
            class="tool-card-thumb"
            src="/images/tap_change_image_chan_twcard.jpg"
            alt={t["tools.card.tapTitle"]}
          />
          <div class="tool-card-body">
            <h2>{t["tools.card.tapTitle"]}</h2>
            <p>{t["tools.card.tapDescription"]}</p>
          </div>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style is:inline>
  .tools-shell {
    max-width: 1040px;
    margin: 0 auto;
    padding: 1.25rem;
    display: grid;
    gap: 1.25rem;
  }

  .tools-header {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    background: rgb(255 255 255);
    padding: 1.2rem 1.3rem;
    display: grid;
    gap: 0.55rem;
  }

  .tools-header h1 {
    margin: 0;
    font-size: clamp(1.7rem, 3.4vw, 2.35rem);
    letter-spacing: 0.01em;
  }

  .tools-header p {
    margin: 0;
    line-height: 1.8;
    max-width: 70ch;
  }

  .tools-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }

  .tool-card {
    border: 1px solid rgb(226 223 214);
    border-radius: 20px;
    overflow: hidden;
    display: grid;
    gap: 0;
    background: rgb(255 255 255);
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .tool-card:hover,
  .tool-card:focus-visible {
    transform: scale(1.01);
    box-shadow: 0 12px 24px rgb(39 30 18 / 12%);
  }

  .tool-card-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    object-position: center;
    background: rgb(255 255 255);
    image-rendering: auto;
    padding: 0.45rem;
  }

  .tool-card-body {
    padding: 1rem 1.05rem 1.1rem;
    display: grid;
    gap: 0.5rem;
  }

  .tool-card h2 {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 700;
  }

  .tool-card p {
    margin: 0;
    line-height: 1.72;
  }

  @media (width <= 768px) {
    .tools-shell {
      padding: 1rem;
      gap: 1rem;
    }

    .tools-header {
      padding: 1rem;
      border-radius: 18px;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .tool-card {
      border-radius: 16px;
    }
  }
</style>
