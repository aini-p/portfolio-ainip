---
import HomeStyleSidebars from "~/components/HomeStyleSidebars.astro";
import NativeAdSlot from "~/components/NativeAdSlot.astro";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

const lang = "en";
const t = ui[lang];
const tapToolPath = "/en/tools/tap-change-image";
const fourToolPath = "/en/tools/four-split-image";
const packToolPath = "/en/tools/random-pack-image";
const pdfToolPath = "/en/tools/image-to-pdf";
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t["tools.pageTitle"],
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t["tools.card.tapTitle"],
      url: new URL(tapToolPath, Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: t["tools.card.fourTitle"],
      url: new URL(fourToolPath, Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: t["tools.card.packTitle"],
      url: new URL(packToolPath, Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 4,
      name: t["tools.card.pdfTitle"],
      url: new URL(pdfToolPath, Astro.site).toString(),
    },
  ],
};
---

<BaseLayout
  title={t["tools.pageTitle"]}
  description={t["tools.pageDescription"]}
  keywords="creator support tools, web tools, image tools, png, illustration, free browser tools"
  image={{ src: "/images/tap_change_image_chan_twcard.jpg", alt: t["tools.card.tapTitle"] }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />

  <div class="sidebar-page-shell">
   <div class="sidebar-page-grid">
    <HomeStyleSidebars lang={lang}>
      <div class="main-column">
        <NativeAdSlot lang={lang} />

        <section class="tools-shell">
          <header class="tools-header">
            <h1>{t["tools.heading"]}</h1>
            <p>{t["tools.lead"]}</p>
          </header>

          <ul class="tools-grid">
            <li>
              <a class="tool-card" href={tapToolPath}>
                <img
                  class="tool-card-thumb"
                  src="/images/tap_change_image_chan_twcard.jpg"
                  alt={t["tools.card.tapTitle"]}
                />
                <div class="tool-card-body">
                  <h2>{t["tools.card.tapTitle"]}</h2>
                  <p>{t["tools.card.tapDescription"]}</p>
                </div>
              </a>
            </li>
            <li>
              <a class="tool-card" href={fourToolPath}>
                <img
                  class="tool-card-thumb"
                  src="/images/four_split_guard_1.svg"
                  alt={t["tools.card.fourTitle"]}
                />
                <div class="tool-card-body">
                  <h2>{t["tools.card.fourTitle"]}</h2>
                  <p>{t["tools.card.fourDescription"]}</p>
                </div>
              </a>
            </li>
            <li>
              <a class="tool-card" href={packToolPath}>
                <img
                  class="tool-card-thumb"
                  src="/images/random_pack_image_chan.svg"
                  alt={t["tools.card.packTitle"]}
                />
                <div class="tool-card-body">
                  <h2>{t["tools.card.packTitle"]}</h2>
                  <p>{t["tools.card.packDescription"]}</p>
                </div>
              </a>
            </li>
            <li>
              <a class="tool-card" href={pdfToolPath}>
                <div class="tool-card-thumb tool-card-thumb-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
                    <rect width="64" height="64" rx="14" fill="#dbeafe"/>
                    <rect x="14" y="10" width="26" height="34" rx="3" fill="#93c5fd" stroke="#1a6eb5" stroke-width="1.5"/>
                    <rect x="24" y="20" width="26" height="34" rx="3" fill="#bfdbfe" stroke="#1a6eb5" stroke-width="1.5"/>
                    <path d="M30 34h14M30 40h10" stroke="#1a6eb5" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </div>
                <div class="tool-card-body">
                  <h2>{t["tools.card.pdfTitle"]}</h2>
                  <p>{t["tools.card.pdfDescription"]}</p>
                </div>
              </a>
            </li>
          </ul>
        </section>
      </div>
    </HomeStyleSidebars>
   </div>
  </div>
</BaseLayout>

<style is:inline>
  .tools-shell {
    display: grid;
    gap: 1.25rem;
  }

  .tools-header {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    padding: 1.2rem 1.3rem;
    display: grid;
    gap: 0.55rem;
  }

  .tools-header h1 {
    margin: 0;
    font-size: clamp(1.7rem, 3.4vw, 2.35rem);
    letter-spacing: 0.01em;
    color: var(--text-primary);
    font-weight: 500;
  }

  .tools-header p {
    margin: 0;
    line-height: 1.8;
    max-width: 70ch;
    color: var(--text-secondary);
  }

  .tools-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }

  .tool-card {
    border: 0.5px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
    gap: 0;
    background: var(--bg-elevated);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s ease;
  }

  .tool-card:hover,
  .tool-card:focus-visible {
    border-color: var(--accent-strong);
  }

  .tool-card-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    object-position: center;
    background: var(--bg-elevated-2);
    image-rendering: auto;
    padding: 0.45rem;
  }

  .tool-card-thumb-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .tool-card-thumb-icon svg {
    width: 64px;
    height: 64px;
  }

  .tool-card-body {
    padding: 1rem 1.05rem 1.1rem;
    display: grid;
    gap: 0.5rem;
  }

  .tool-card h2 {
    margin: 0;
    font-size: 1.12rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .tool-card p {
    margin: 0;
    line-height: 1.72;
    color: var(--text-secondary);
  }

  @media (width <= 768px) {
    .tools-shell {
      gap: 1rem;
    }

    .tools-header {
      padding: 1rem;
      border-radius: 18px;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .tool-card {
      border-radius: 16px;
    }
  }
</style>
