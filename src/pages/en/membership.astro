---
import { membershipFaq, membershipFeatureHighlights, topTierHighlights } from "~/constants/membershipContent";
import { membershipTiers } from "~/constants/membershipTiers";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

const lang = "en";
const t = ui[lang];
const topTier = membershipTiers[membershipTiers.length - 1];
---

<BaseLayout title={t["membership.pageTitle"]} description={t["membership.pageDescription"]}>
  <div class="membership-lp">
    <section class="mship-hero" id="hero">
      <div class="mship-container hero-grid">
        <div class="hero-copy">
          <p class="hero-eyebrow">FAN CLUB MEMBERSHIP</p>
          <h1>{t["membership.heroCatch"]}</h1>
          <p class="hero-sub">{t["membership.heroSub"]}</p>
          <a href="#pricing" class="hero-cta">
            {t["membership.heroCta"]} <i class="ti ti-arrow-narrow-down" aria-hidden="true"></i>
          </a>
        </div>
        <div class="hero-visual">
          <img src="/images/placeholder-membership-hero.svg" alt={t["membership.heroImageAlt"]} width="480" height="480" loading="eager" />
        </div>
      </div>
    </section>

    <section class="mship-features" id="features">
      <div class="mship-container">
        <h2>{t["membership.featuresHeading"]}</h2>
        <div class="features-grid">
          {membershipFeatureHighlights.map((feature) => (
            <div class="feature-card">
              <span class="feature-icon" aria-hidden="true">{feature.icon}</span>
              <h3>{feature.title[lang]}</h3>
              <p>{feature.desc[lang]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mship-pricing" id="pricing">
      <div class="mship-container">
        <h2>{t["membership.pricingHeading"]}</h2>
        <p class="pricing-lead">{t["membership.pricingLead"]}</p>
        <div class="tier-grid">
          {membershipTiers.map((tier) => (
            <div class:list={["tier-card", { "tier-premium": tier.popular }]}>
              {tier.popular && tier.badge && <span class="tier-badge">{tier.badge[lang]}</span>}
              <div class="tier-head">
                <h3>{tier.name[lang]}</h3>
                <p class="tier-tagline">{tier.tagline[lang]}</p>
              </div>
              <p class="tier-price">
                <span class="amount">{tier.price[lang]}</span>
                <span class="period">{tier.period[lang]}</span>
              </p>
              <ul class="tier-features">
                {tier.features.map((feature) => (
                  <li class:list={{ "is-excluded": !feature.included }}>
                    {tier.customIcons ? (
                      <span>{feature.text[lang]}</span>
                    ) : (
                      <>
                        <i
                          class:list={["ti", feature.included ? "ti-check" : "ti-x"]}
                          aria-label={feature.included ? t["membership.includedLabel"] : t["membership.notIncludedLabel"]}
                        ></i>
                        <span>{feature.text[lang]}</span>
                      </>
                    )}
                  </li>
                ))}
              </ul>
              <a
                href={tier.patreonTierUrl}
                target="_blank"
                rel="noopener noreferrer"
                class:list={["tier-cta", { "tier-cta-premium": tier.popular }]}
              >
                {t["membership.tierCta"]} <i class="ti ti-external-link" aria-hidden="true"></i>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mship-toptier" id="top-tier">
      <div class="mship-container">
        <h2>{t["membership.topTierHeading"]}</h2>
        <div class="toptier-list">
          {topTierHighlights.map((item, index) => (
            <div class:list={["toptier-item", { reverse: index % 2 === 1 }]}>
              <div class="toptier-visual">
                <img src={item.image} alt={item.imageAlt[lang]} width="320" height="210" loading="lazy" />
              </div>
              <div class="toptier-copy">
                <h3>{item.title[lang]}</h3>
                <p>{item.body[lang]}</p>
                {item.note && <p class="toptier-note">{item.note[lang]}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mship-faq" id="faq">
      <div class="mship-container">
        <h2>{t["membership.faqHeading"]}</h2>
        <div class="faq-list">
          {membershipFaq.map((item, index) => (
            <div class="faq-item">
              <button type="button" class="faq-question" aria-expanded="false" aria-controls={`faq-answer-${index}`}>
                <span>{item.question[lang]}</span>
                <i class="ti ti-chevron-down" aria-hidden="true"></i>
              </button>
              <div class="faq-answer" id={`faq-answer-${index}`}>
                <p>{item.answer[lang]}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mship-footer-cta">
      <div class="mship-container">
        <h2>{t["membership.footerCatch"]}</h2>
        <a href={topTier.patreonTierUrl} target="_blank" rel="noopener noreferrer" class="footer-cta-button">
          {t["membership.footerCta"]}
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".faq-question").forEach((button) => {
    button.addEventListener("click", () => {
      const isOpen = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", isOpen ? "false" : "true");
      const answer = document.getElementById(button.getAttribute("aria-controls") ?? "");
      answer?.classList.toggle("is-open", !isOpen);
    });
  });
</script>

<style is:inline>
  .membership-lp {
    --gold: #e8c37a;
    --gold-strong: #f3d99a;
    --pink: #d874a0;
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    padding-bottom: 1rem;
  }

  .mship-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .membership-lp section h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text-primary);
    text-align: center;
  }

  /* ---------- Hero ---------- */
  .mship-hero {
    position: relative;
    padding: clamp(2rem, 5vw, 3.5rem) 1.25rem;
    background:
      radial-gradient(120% 140% at 12% 0%, rgb(212 175 122 / 18%) 0%, transparent 55%),
      radial-gradient(120% 140% at 90% 100%, rgb(216 116 160 / 16%) 0%, transparent 55%),
      linear-gradient(160deg, var(--bg-elevated) 0%, var(--bg-page) 100%);
    border-bottom: 0.5px solid var(--border-subtle);
    overflow: hidden;
  }

  .hero-grid {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .hero-copy {
    flex: 1 1 480px;
    display: grid;
    gap: 1.1rem;
  }

  .hero-eyebrow {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    color: var(--gold);
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    line-height: 1.4;
    font-weight: 500;
    color: var(--text-primary);
  }

  .hero-sub {
    margin: 0;
    max-width: 52ch;
    color: var(--text-secondary);
    line-height: 1.85;
    font-size: 0.98rem;
  }

  .hero-cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    padding: 0.85rem 1.8rem;
    border-radius: 999px;
    background: linear-gradient(120deg, var(--accent-strong), var(--pink));
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 8px 24px rgb(155 99 214 / 35%);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgb(155 99 214 / 45%);
  }

  .hero-visual {
    flex: 0 1 340px;
    display: flex;
    justify-content: center;
  }

  .hero-visual img {
    width: 100%;
    max-width: 340px;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 50px rgb(0 0 0 / 35%);
  }

  /* ---------- Features ---------- */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.1rem;
    margin-top: 2rem;
  }

  .feature-card {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.5rem 1.3rem;
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 0.5px solid var(--border-subtle);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-strong);
  }

  .feature-icon {
    font-size: 1.8rem;
    line-height: 1;
  }

  .feature-card h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .feature-card p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.75;
  }

  /* ---------- Pricing ---------- */
  .mship-pricing {
    padding: 1rem 1.25rem;
    scroll-margin-top: 90px;
  }

  .pricing-lead {
    margin: 0 auto;
    max-width: 46ch;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .tier-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    margin-top: 2.5rem;
  }

  .tier-card {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 1.75rem 1.5rem 2rem;
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 0.5px solid var(--border-subtle);
    transition: transform 0.25s ease;
  }

  .tier-premium {
    border: 2px solid transparent;
    background:
      linear-gradient(var(--bg-elevated), var(--bg-elevated)) padding-box,
      linear-gradient(150deg, var(--gold), var(--pink), var(--accent-strong)) border-box;
    box-shadow: 0 18px 44px rgb(232 195 122 / 20%);
    transform: scale(1.04);
    z-index: 1;
  }

  .tier-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background: linear-gradient(120deg, var(--gold), var(--pink));
    color: #241a10;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 4px 16px;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgb(0 0 0 / 30%);
  }

  .tier-head h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .tier-tagline {
    margin: 0.2rem 0 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .tier-price {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .tier-price .amount {
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .tier-premium .tier-price .amount {
    color: var(--gold-strong);
  }

  .tier-price .period {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .tier-features {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.65rem;
  }

  .tier-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .tier-features li.is-excluded {
    color: var(--text-muted);
    text-decoration: line-through;
    text-decoration-color: var(--border-strong);
  }

  .tier-features li i {
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .tier-features li i.ti-check {
    color: var(--accent-strong);
  }

  .tier-premium .tier-features li i.ti-check {
    color: var(--gold-strong);
  }

  .tier-features li i.ti-x {
    color: var(--text-muted);
  }

  .tier-cta {
    justify-self: stretch;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding: 0.75rem 1.2rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .tier-cta:hover {
    background: var(--accent-strong);
    transform: translateY(-2px);
  }

  .tier-cta-premium {
    background: linear-gradient(120deg, var(--gold), var(--pink));
    color: #241a10;
  }

  .tier-cta-premium:hover {
    box-shadow: 0 10px 26px rgb(232 195 122 / 35%);
  }

  /* ---------- Top tier highlights ---------- */
  .mship-toptier {
    padding: 1rem 1.25rem;
  }

  .toptier-list {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  .toptier-item {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .toptier-item.reverse {
    flex-direction: row-reverse;
  }

  .toptier-visual {
    flex: 0 0 auto;
    width: min(320px, 42%);
  }

  .toptier-visual img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 40px rgb(0 0 0 / 30%);
  }

  .toptier-copy {
    flex: 1;
    display: grid;
    gap: 0.7rem;
  }

  .toptier-copy h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.5;
  }

  .toptier-copy p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.85;
    font-size: 0.95rem;
  }

  .toptier-note {
    color: var(--gold) !important;
    font-size: 0.82rem !important;
  }

  /* ---------- FAQ ---------- */
  .mship-faq {
    padding: 1rem 1.25rem;
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
    max-width: 760px;
    margin-inline: auto;
  }

  .faq-item {
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    border: 0.5px solid var(--border-subtle);
    overflow: hidden;
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.3rem;
    background: none;
    border: none;
    color: var(--text-primary);
    font-size: 0.96rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .faq-question i {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }

  .faq-question[aria-expanded="true"] i {
    transform: rotate(180deg);
    color: var(--accent-strong);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
  }

  .faq-answer.is-open {
    max-height: 320px;
  }

  .faq-answer p {
    margin: 0;
    padding: 0 1.3rem 1.2rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.8;
  }

  /* ---------- Footer CTA ---------- */
  .mship-footer-cta {
    padding: clamp(2.5rem, 6vw, 4rem) 1.25rem;
    text-align: center;
    background:
      radial-gradient(120% 160% at 50% 0%, rgb(232 195 122 / 14%) 0%, transparent 60%),
      var(--bg-elevated);
    border-top: 0.5px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .mship-footer-cta h2 {
    margin-bottom: 1.5rem;
  }

  .footer-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2.4rem;
    border-radius: 999px;
    background: linear-gradient(120deg, var(--gold), var(--pink));
    color: #241a10;
    font-weight: 700;
    font-size: 1.02rem;
    text-decoration: none;
    box-shadow: 0 14px 34px rgb(232 195 122 / 30%);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .footer-cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgb(232 195 122 / 40%);
  }

  /* ---------- Responsive ---------- */
  @media (width <= 960px) {
    .tier-grid {
      grid-template-columns: 1fr;
      max-width: 460px;
      margin-inline: auto;
    }

    .tier-premium {
      transform: none;
      order: -1;
    }
  }

  @media (width <= 860px) {
    .hero-grid {
      flex-direction: column-reverse;
      text-align: center;
    }

    .hero-copy {
      align-items: center;
    }

    .hero-cta {
      justify-self: center;
    }

    .toptier-item,
    .toptier-item.reverse {
      flex-direction: column;
      text-align: center;
    }

    .toptier-visual {
      width: min(320px, 80%);
    }
  }

  @media (width <= 640px) {
    .membership-lp {
      gap: 3rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
