---
import { getCollection } from "astro:content";
import ArtworkCard from "~/components/ArtworkCard.astro";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  formatImageCountLabel,
  getHeaderImage,
  getTotalImageCount,
} from "~/utils/artwork";

const lang = "en";
const t = ui[lang];

const artworks = await getCollection("artworks", ({ id }) =>
  id.startsWith(`${lang}/`),
);
const sorted = [...artworks].sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

function toSlug(fullSlug: string) {
  return fullSlug.replace(`${lang}/`, "");
}
function toHref(fullSlug: string) {
  return `/en/gallery/${toSlug(fullSlug)}`;
}
---
<BaseLayout title={t["gallery.pageTitle"]} description={t["gallery.pageDescription"]}>
  <div class="gallery-shell">
    <header class="gallery-header">
      <h1>{t["gallery.heading"]}</h1>
      <p>{t["gallery.lead"]}</p>
    </header>

    <div class="gallery-grid">
      {sorted.map((artwork, index) => (
        <ArtworkCard
          href={toHref(artwork.slug)}
          title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
          image={getHeaderImage(artwork)}
          slug={toSlug(artwork.slug)}
          eager={index < 8}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style is:inline>
  .gallery-shell {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 3rem;
    display: grid;
    gap: 1.5rem;
  }

  .gallery-header h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.7rem, 3.4vw, 2.35rem);
    color: var(--text-primary);
  }

  .gallery-header p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 65ch;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem 1rem;
  }

  @media (width <= 768px) {
    .gallery-shell { padding: 1rem 1rem 2rem; gap: 1.25rem; }
    .gallery-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  }
</style>
