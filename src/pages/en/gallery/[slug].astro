---
import { getImage, Image } from "astro:assets";
import { getCollection } from "astro:content";
import AffiliateColumn from "~/components/AffiliateColumn.astro";
import ArticleImageStack from "~/components/ArticleImageStack.astro";
import ArtworkCard from "~/components/ArtworkCard.astro";
import AuthorComment from "~/components/AuthorComment.astro";
import LikeButton from "~/components/LikeButton.astro";
import ShareButtons from "~/components/ShareButtons.astro";
import SidebarSection from "~/components/SidebarSection.astro";
import { patreonMembershipUrl } from "~/constants/social";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  formatImageCountLabel,
  formatMembershipCtaLead,
  getArtworkCharacters,
  getHeaderImage,
  getPortfolioImages,
  getSampleImages,
  getShareImage,
  getTotalImageCount,
} from "~/utils/artwork";
import { toPathSafeSlug } from "~/utils/slug";

const lang = "en";
// 英語ページとして固定

export async function getStaticPaths() {
  const artworks = await getCollection("artworks", ({ id }) =>
    id.startsWith("en/"),
  );
  return artworks.map((artwork) => ({
    params: { slug: artwork.slug.replace(/^(en)\//, "") },
    props: { artwork },
  }));
}

const { artwork } = Astro.props;
const { Content } = await artwork.render();
const t = ui[lang];

const allCharacters = getArtworkCharacters(artwork);
const portfolioImages = getPortfolioImages(artwork);
const sampleImages = getSampleImages(artwork);
const totalImageCount = getTotalImageCount(artwork);
const hasBody = Boolean(artwork.body?.trim().length);

const pageUrl = new URL(
  `/en/gallery/${artwork.slug.replace(`${lang}/`, "")}`,
  Astro.site,
).toString();

const shareImage = await getImage({
  src: getShareImage(artwork),
  format: "webp",
  width: 1200,
});

const allArtworks = await getCollection("artworks", ({ id }) =>
  id.startsWith(`${lang}/`),
);

const relatedBySeries = artwork.data.series
  ? allArtworks
      .filter(
        (a) => a.slug !== artwork.slug && a.data.series === artwork.data.series,
      )
      .sort(
        (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
      )
      .slice(0, 6)
  : [];

const sameSeriesDoujinshi = artwork.data.series
  ? (
      await getCollection("doujinshi", ({ id }) => id.startsWith(`${lang}/`))
    ).filter((d) => d.data.series === artwork.data.series)
  : [];

const relatedArtworks = artwork.data.relatedImages
  ? await getCollection("artworks", ({ id, slug }) => {
      const artworkLang = id.split("/")[0];
      const artworkSlug = slug.replace(/^(en)\//, "");
      return (
        artworkLang === lang &&
        artwork.data.relatedImages?.includes(artworkSlug)
      );
    })
  : [];
---
<BaseLayout
  title={artwork.data.title}
  description={artwork.data.description}
  keywords={artwork.data.keywords.join(', ')}
  image={{ src: shareImage.src, alt: artwork.data.title }}
>
  <div class="detail-shell">
   <div class="detail-grid">
    <AffiliateColumn lang={lang} />

    <article class="main-column">
      <h1>{artwork.data.title}{formatImageCountLabel(totalImageCount, lang)}</h1>

      <div class="hero-frame">
        <Image
          src={getHeaderImage(artwork)}
          alt={artwork.data.title}
          quality="max"
          format="webp"
          width={1200}
        />
      </div>

      <div class="artwork-meta">
        {artwork.data.series && (
          <a class="series-tag" href={`/en/gallery/series/${encodeURIComponent(toPathSafeSlug(artwork.data.series))}`}>
            {artwork.data.series}
          </a>
        )}
        {allCharacters.map((char) => (
          <a class="character-tag" href={`/en/gallery/character/${encodeURIComponent(toPathSafeSlug(char))}`}>
            {char}
          </a>
        ))}
      </div>

      <div class="action-row">
        <LikeButton slug={artwork.slug.replace(`${lang}/`, "")} />
        <ShareButtons lang={lang} url={pageUrl} text={artwork.data.title} />
      </div>

      {hasBody && (
        <AuthorComment
          heading={t["doujinshi.authorCommentHeading"]}
          profileLabel={t["nav.profile"]}
          profileHref="/en/profile"
        >
          <Content />
        </AuthorComment>
      )}

      <div class="membership-intro">
        <div class="membership-intro-copy">
          <p class="membership-intro-lead"><i class="ti ti-lock-open" aria-hidden="true"></i> {t["artwork.introSample"]}</p>
          <p class="membership-intro-detail">
            Members can view all <strong>{totalImageCount} images</strong>, unfiltered!
          </p>
        </div>
        <a href="/en/membership" class="membership-intro-link">
          {t["artwork.membershipMoreLink"]} <i class="ti ti-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <ArticleImageStack images={portfolioImages} groupId="portfolio" eagerCount={2} />

      {sampleImages.length > 0 && (
        <ArticleImageStack images={sampleImages} groupId="sample" eagerCount={0} />
      )}

      <div class="membership-outro">
        <p class="membership-cta-lead">{formatMembershipCtaLead(totalImageCount, lang)}</p>
        <a href={patreonMembershipUrl} target="_blank" rel="noopener noreferrer" class="membership-cta">
          <span class="membership-cta-text">
            <strong>{t["artwork.membershipCta"]}</strong>
            <i class="ti ti-external-link" aria-hidden="true"></i>
          </span>
        </a>
        <a href="/en/membership" class="membership-more-link">{t["artwork.membershipMoreLink"]}</a>
      </div>

      {relatedArtworks.length > 0 && (
        <div class="related-works">
          <h2>{t['artwork.related']}</h2>
          <div class="thumbnail-grid">
            {relatedArtworks.map((related) => (
              <ArtworkCard
                href={`/en/gallery/${related.slug.replace(`${lang}/`, '')}`}
                title={`${related.data.title}${formatImageCountLabel(getTotalImageCount(related), lang)}`}
                image={getHeaderImage(related)}
                slug={related.slug.replace(`${lang}/`, '')}
              />
            ))}
          </div>
        </div>
      )}

      <div class="action-row action-row-bottom">
        <LikeButton slug={artwork.slug.replace(`${lang}/`, "")} />
        <ShareButtons lang={lang} url={pageUrl} text={artwork.data.title} />
      </div>
    </article>

    <aside class="sidebar-column sidebar-column-right">
      {artwork.data.series && sameSeriesDoujinshi.length > 0 && (
        <SidebarSection
          title={`${artwork.data.series}${t["sidebar.doujinshiBySeries"]}`}
          href="/en/doujinshi"
        >
          {sameSeriesDoujinshi.map((item) => (
            <a class="recommend-card" href={`/en/doujinshi/${item.slug.replace(`${lang}/`, '')}`}>
              <Image src={item.data.packageImage} alt={item.data.title} format="webp" width={240} />
            </a>
          ))}
        </SidebarSection>
      )}

      {artwork.data.series && relatedBySeries.length > 0 && (
        <SidebarSection
          title={`${artwork.data.series}${t["sidebar.moreBySeries"]}`}
          href={`/en/gallery/series/${encodeURIComponent(toPathSafeSlug(artwork.data.series))}`}
        >
          {relatedBySeries.map((related) => (
            <ArtworkCard
              href={`/en/gallery/${related.slug.replace(`${lang}/`, '')}`}
              title={`${related.data.title}${formatImageCountLabel(getTotalImageCount(related), lang)}`}
              image={getHeaderImage(related)}
              slug={related.slug.replace(`${lang}/`, '')}
            />
          ))}
        </SidebarSection>
      )}
    </aside>
   </div>
  </div>
</BaseLayout>
<style is:inline>
  .detail-shell {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    display: grid;
    gap: 2rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }

  .main-column {
    display: grid;
    gap: 1.6rem;
    min-width: 0;
  }

  .sidebar-column {
    display: grid;
    gap: 1.75rem;
    min-width: 0;
    position: sticky;
    top: 96px;
  }

  /* Only show the left affiliate column when there's enough spare width that it
     won't eat into the main content column */
  .sidebar-column-left {
    display: none;
  }

  @media (min-width: 1480px) {
    .detail-shell {
      max-width: 1520px;
    }
    .detail-grid {
      grid-template-columns: 280px 1fr 300px;
    }
    .sidebar-column-left {
      display: grid;
    }
  }

  .hero-frame {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-elevated);
  }
  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  h1 { font-size: 2.0rem; margin: 0; color: var(--text-primary); }

  .artwork-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .character-tag {
    font-size: 0.82rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 0.5px solid var(--border-strong);
    color: var(--text-secondary);
    text-decoration: none;
  }
  .character-tag:hover { border-color: var(--accent-strong); color: var(--text-primary); }

  .series-tag {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 0.5px solid var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
    text-decoration: none;
  }
  .series-tag:hover { background: var(--accent); color: #fff; }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .action-row-bottom {
    padding-top: 1.6rem;
    border-top: 0.5px solid var(--border-subtle);
  }

  .membership-intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1rem 1.2rem;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    border: 0.5px solid var(--accent);
    color: var(--text-primary);
  }
  .membership-intro-copy { display: grid; gap: 0.3rem; }
  .membership-intro-lead { margin: 0; font-size: 0.95rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem; }
  .membership-intro-lead i { color: var(--heart); font-size: 16px; }
  .membership-intro-detail { margin: 0; font-size: 1rem; font-weight: 600; color: var(--text-primary); }
  .membership-intro-detail strong { color: var(--accent-strong); font-size: 1.15em; }
  .membership-intro-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 0.5px solid var(--accent);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .membership-intro-link:hover { background: var(--accent); color: #fff; }

  .membership-outro {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }
  .membership-cta-lead {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-align: center;
  }

  .membership-cta {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .membership-cta:hover,
  .membership-cta:focus-visible {
    transform: scale(1.01);
  }
  .membership-cta-text {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    font-size: 1.15rem;
  }
  .membership-cta-text i { font-size: 18px; }

  .membership-more-link {
    justify-self: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .membership-more-link:hover { color: var(--text-primary); }

  .related-works { margin-top: 0.5rem; }
  .related-works h2 { font-size: 1.3rem; margin-bottom: 1rem; color: var(--text-primary); font-weight: 500; border-bottom: 0.5px solid var(--border-subtle); padding-bottom: 0.5rem; }
  .thumbnail-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 1rem; }

  .recommend-card {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--bg-elevated-2);
  }
  .recommend-card img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 960px) {
    .detail-grid { grid-template-columns: 1fr; }
    .sidebar-column { position: static; }
  }

  @media (max-width: 768px) {
    .detail-shell { padding: 1rem; gap: 1.25rem; }
    h1 { font-size: 1.6rem; }
    .related-works h2 { font-size: 1.15rem; }
    .membership-cta-text { font-size: 1rem; }
  }
</style>
