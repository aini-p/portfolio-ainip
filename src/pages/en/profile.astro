---
import ShareButtons from "~/components/ShareButtons.astro";
import {
  discordUrl,
  patreonUrl,
  profileNames,
  xAccountNames,
  xAccountUrls,
} from "~/constants/social";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

const lang = "en"; // 英語ページとして固定
const t = ui[lang];

const profileName = profileNames[lang];
const profileDescription =
  "Illustrator / AI + Retouch / DM for work inquiries.";
const profilePageTitle = t["nav.profile"];
const profileKeywords = "profile, illustrator, ai art, At5Fun";
const xNames = xAccountNames[lang];
const pageUrl = new URL("/en/", Astro.site).toString();
---
<BaseLayout
  title={profilePageTitle}
  description={profileDescription}
  keywords={profileKeywords}
  image={{ src: "/images/profile-share-card.png", alt: "Share card image for profile page" }}
>
  <div class="container">
    <section class="profile-section">
      <img src="/images/icon.png" alt="Profile Icon" class="profile-icon" />
      <div class="profile-text">
        <h1>{profileName}</h1>
        <p>{profileDescription}</p>
        <div class="contact-links">
          <a href={discordUrl} target="_blank" rel="noopener noreferrer" class="icon-link discord-icon" aria-label="Contact via Discord">
            <img src="/Discord_Symbol_Color/Discord-Symbol-Blurple.svg" alt="Discord" />
          </a>
        </div>
        <div class="share-row">
          <ShareButtons lang={lang} url={pageUrl} text={t["profile.shareText"]} />
        </div>
      </div>
    </section>
    <section class="links-section">
      <h2>X (Twitter)</h2>
      <div class="x-accounts">
        <a href={xAccountUrls[0]} target="_blank" rel="noopener noreferrer">
          <img src="/images/icon_x1.jpg" alt="X Icon" />
          <span>{xNames[0]}</span>
        </a>
        <a href={xAccountUrls[1]} target="_blank" rel="noopener noreferrer">
          <img src="/images/icon_x2.jpg" alt="X Icon" />
          <span>{xNames[1]}</span>
        </a>
        <a href={xAccountUrls[3]} target="_blank" rel="noopener noreferrer">
          <img src="/images/icon.png" alt="X Icon" />
          <span>{xNames[3]}</span>
        </a>
        <a href={xAccountUrls[4]} target="_blank" rel="noopener noreferrer">
          <img src="/images/icon_x5.jpg" alt="X Icon" />
          <span>{xNames[4]}</span>
        </a>
      </div>
    </section>
    <section class="links-section membership-section">
      <h2>{t['profile.fansite']}</h2>
      <div class="banner-links">
        <a href={patreonUrl} target="_blank" rel="noopener noreferrer" class="banner-link">
          <img src="/images/patreon-banner.png" alt="Patreon" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
<style is:inline>
  .container {
    max-width: 980px;
    margin: 0 auto;
    padding: 1.4rem;
    display: grid;
    gap: 1.4rem;
  }

  .profile-section,
  .links-section {
    min-width: 0;
    border: 0.5px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
  }

  .profile-section {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.8rem;
    padding: 1.4rem;
  }

  .profile-icon {
    width: 168px;
    height: 168px;
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-text h1 {
    margin: 0 0 0.65rem;
    font-size: clamp(1.7rem, 3.5vw, 2.25rem);
    color: var(--text-primary);
  }

  .profile-text p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--text-secondary);
  }

  .contact-links {
    display: flex;
    gap: 0.8rem;
    margin-top: 1.05rem;
  }

  .share-row {
    margin-top: 0.9rem;
  }

  .icon-link {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0.5px solid var(--border-strong);
    background: var(--bg-elevated-2);
    transition: transform 0.24s ease, border-color 0.24s ease;
  }

  .icon-link:hover,
  .icon-link:focus-visible {
    transform: scale(1.02);
    border-color: var(--accent-strong);
  }

  .discord-icon img {
    width: 26px;
    height: 26px;
  }

  .links-section {
    padding: 1.25rem 1.3rem 1.35rem;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-primary);
  }

  .x-accounts {
    display: flex;
    gap: 0.8rem;
    overflow-x: auto;
    padding: 0.45rem 0.45rem 1rem;
    scrollbar-width: thin;
  }

  .x-accounts a {
    display: flex;
    flex: 0 0 clamp(150px, 18vw, 190px);
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.8rem;
    border-radius: var(--radius-md);
    border: 0.5px solid var(--border-subtle);
    background: var(--bg-elevated-2);
    text-decoration: none;
    color: var(--text-primary);
    transition: border-color 0.24s ease;
  }

  .x-accounts a:hover,
  .x-accounts a:focus-visible {
    border-color: var(--accent-strong);
  }

  .x-accounts::-webkit-scrollbar {
    height: 6px;
  }

  .x-accounts::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 999px;
  }

  .x-accounts img {
    width: 42px;
    height: 42px;
    border-radius: 10px;
  }

  .membership-section {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .banner-links {
    display: grid;
    gap: 1rem;
  }

  .banner-link img {
    width: 100%;
    border-radius: var(--radius-md);
    transition: transform 0.3s ease;
  }

  .banner-link:hover img,
  .banner-link:focus-visible img {
    transform: scale(1.01);
  }

  @media (width <= 768px) {
    .container {
      padding: 1rem;
      gap: 1rem;
    }

    .profile-section {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 1rem;
      padding: 1rem;
    }

    .profile-icon {
      width: 132px;
      height: 132px;
    }

    .profile-text {
      display: grid;
      justify-items: center;
      gap: 0.1rem;
    }

    .links-section {
      padding: 1rem;
    }
  }
</style>
