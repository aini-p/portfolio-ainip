---
import ProfileContent from "~/components/ProfileContent.astro";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";

const lang = "en"; // 英語ページとして固定
const t = ui[lang];

const profileDescription =
  "Illustrator / AI + Retouch / DM for work inquiries.";
const profilePageTitle = t["nav.profile"];
const profileKeywords = "profile, illustrator, ai art, At5Fun";
const pageUrl = new URL("/en/", Astro.site).toString();
---
<BaseLayout
  title={profilePageTitle}
  description={profileDescription}
  keywords={profileKeywords}
  image={{ src: "/images/profile-share-card.png", alt: "Share card image for profile page" }}
>
  <ProfileContent lang={lang} profileDescription={profileDescription} pageUrl={pageUrl} />
</BaseLayout>
