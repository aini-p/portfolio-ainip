---
import { getCollection } from "astro:content";
import ArtworkCard from "~/components/ArtworkCard.astro";
import { fanzaAffiliateItems } from "~/constants/fanzaAffiliate";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  formatImageCountLabel,
  getHeaderImage,
  getTotalImageCount,
} from "~/utils/artwork";

const lang = "en";
const t = ui[lang];

const artworks = await getCollection("artworks", ({ id }) =>
  id.startsWith(`${lang}/`),
);
const featured = [...artworks]
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 8);
---
<BaseLayout title={t["recommend.pageTitle"]} description={t["recommend.pageDescription"]}>
  <div class="recommend-shell">
    <header class="recommend-header">
      <h1>{t["recommend.heading"]}</h1>
      <p>{t["recommend.lead"]}</p>
    </header>

    <section>
      <h2>{t["recommend.ownWorksHeading"]}</h2>
      <div class="recommend-grid">
        {featured.map((artwork) => (
          <ArtworkCard
            href={`/en/gallery/${artwork.slug.replace(`${lang}/`, "")}`}
            title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
            image={getHeaderImage(artwork)}
            slug={artwork.slug.replace(`${lang}/`, "")}
          />
        ))}
      </div>
    </section>

    <section>
      <h2>{t["recommend.affiliateHeading"]}</h2>
      <div class="recommend-grid">
        {fanzaAffiliateItems.map((item) => (
          <a class="affiliate-card" href={item.affiliateUrl} target="_blank" rel="noopener noreferrer sponsored">
            <div class="affiliate-thumb">
              <img src={item.imageUrl} alt={item.title[lang]} loading="lazy" />
              <span class="affiliate-label">PR</span>
            </div>
            <p>{item.title[lang]}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style is:inline>
  .recommend-shell {
    max-width: 1040px;
    margin: 0 auto;
    padding: 1.25rem;
    display: grid;
    gap: 2rem;
  }

  .recommend-header h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.7rem, 3.4vw, 2.35rem);
    color: var(--text-primary);
  }

  .recommend-header p {
    margin: 0;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  section h2 {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .recommend-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }

  .affiliate-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .affiliate-thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-elevated-2);
  }

  .affiliate-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .affiliate-label {
    position: absolute;
    left: 6px;
    top: 6px;
    background: var(--accent);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .affiliate-card p {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  @media (width <= 768px) {
    .recommend-shell { padding: 1rem; gap: 1.5rem; }
  }
</style>
