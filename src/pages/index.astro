---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import ArtworkCard from "~/components/ArtworkCard.astro";
import Rail from "~/components/Rail.astro";
import SidebarSection from "~/components/SidebarSection.astro";
import { categories } from "~/constants/categories";
import { fanzaAffiliateItems } from "~/constants/fanzaAffiliate";
import { discordUrl, patreonUrl } from "~/constants/social";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  formatImageCountLabel,
  getHeaderImage,
  getTotalImageCount,
} from "~/utils/artwork";
import { toPathSafeSlug } from "~/utils/slug";

const lang = "ja";
const t = ui[lang];

const artworks = await getCollection("artworks", ({ id }) =>
  id.startsWith(`${lang}/`),
);
const doujinshiList = await getCollection("doujinshi", ({ id }) =>
  id.startsWith(`${lang}/`),
);

function toSlug(fullSlug: string) {
  return fullSlug.replace(`${lang}/`, "");
}

function toHref(fullSlug: string) {
  return `/gallery/${toSlug(fullSlug)}`;
}

function toDoujinshiHref(fullSlug: string) {
  return `/doujinshi/${toSlug(fullSlug)}`;
}

const sortedByDate = [...artworks].sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const latestArtworks = sortedByDate.slice(0, 12);

const categoryRails = categories
  .map((category) => ({
    ...category,
    items: sortedByDate.filter(category.match).slice(0, 12),
  }))
  .filter((rail) => rail.items.length > 0);

const recommendArtworks = sortedByDate.slice(0, 3);

// 自作の同人誌(isOwnWork!==false)と、他者作品のレビュー記事(isOwnWork===false)を分離
const ownDoujinshi = [...doujinshiList]
  .filter((d) => d.data.isOwnWork !== false)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const otherDoujinshiReviews = [...doujinshiList]
  .filter((d) => d.data.isOwnWork === false)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 12);
const latestOwnDoujinshi = ownDoujinshi.slice(0, 12);
const recommendOwnDoujinshi = ownDoujinshi.slice(0, 3);

// 作品別セクション: シリーズごとの件数と最新作をまとめる
const seriesMap = new Map<
  string,
  { count: number; latest: (typeof sortedByDate)[number] }
>();
for (const artwork of sortedByDate) {
  const series = artwork.data.series;
  if (!series) continue;
  const existing = seriesMap.get(series);
  if (existing) {
    existing.count += 1;
  } else {
    seriesMap.set(series, { count: 1, latest: artwork });
  }
}
const seriesList = [...seriesMap.entries()]
  .map(([name, data]) => ({ name, count: data.count, latest: data.latest }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 12);

// クライアント側の検索・いいねランキング表示用に、全作品の軽量インデックスを埋め込む
const searchIndex = await Promise.all(
  artworks.map(async (artwork) => {
    const optimized = await getImage({
      src: getHeaderImage(artwork),
      width: 480,
      format: "webp",
    });
    return {
      slug: toSlug(artwork.slug),
      title: artwork.data.title,
      thumb: optimized.src,
      imageCount: getTotalImageCount(artwork),
      characters: [
        artwork.data.main_character,
        ...(artwork.data.sub_characters ?? []),
      ].filter(Boolean),
      series: artwork.data.series,
      keywords: artwork.data.keywords ?? [],
    };
  }),
);
---
<BaseLayout>
  <div class="home">
   <div class="home-grid">
    <div class="main-column">
      <div class="search-bar">
        <i class="ti ti-search" aria-hidden="true"></i>
        <input type="search" id="artwork-search" placeholder={t["home.searchPlaceholder"]} />
      </div>

      <p class="search-empty" id="search-empty" hidden>{t["home.noResults"]}</p>
      <div class="search-results-grid" id="search-results" hidden></div>

      <div id="rails-view" class="rails-view">
        <Rail title={t["home.latest"]}>
          {latestArtworks.map((artwork, index) => (
            <ArtworkCard
              href={toHref(artwork.slug)}
              title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
              image={getHeaderImage(artwork)}
              slug={toSlug(artwork.slug)}
              eager={index < 4}
            />
          ))}
        </Rail>

        <Rail title={t["home.recommendHeading"]} seeMoreHref="/recommend" seeMoreLabel={t["home.recommendHeading"]}>
          {recommendArtworks.map((artwork) => (
            <ArtworkCard
              href={toHref(artwork.slug)}
              title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
              image={getHeaderImage(artwork)}
              slug={toSlug(artwork.slug)}
            />
          ))}
          {fanzaAffiliateItems.map((item) => (
            <a class="artwork-card affiliate-card" href={item.affiliateUrl} target="_blank" rel="noopener noreferrer sponsored">
              <div class="thumb">
                <img src={item.imageUrl} alt={item.title[lang]} loading="lazy" />
                <span class="affiliate-label">PR</span>
              </div>
              <p class="card-title">{item.title[lang]}</p>
            </a>
          ))}
        </Rail>

        <a class="promo-banner promo-banner-membership" href={patreonUrl} target="_blank" rel="noopener noreferrer">
          <div class="promo-copy">
            <h2>{t["home.membershipHeading"]}</h2>
            <p>{t["home.membershipBody"]}</p>
            <span class="promo-cta">{t["home.membershipCta"]} <i class="ti ti-external-link" aria-hidden="true"></i></span>
          </div>
        </a>

        {latestOwnDoujinshi.length > 0 && (
          <Rail title={t["home.doujinshiLatestHeading"]} seeMoreHref="/doujinshi" seeMoreLabel={t["home.doujinshiLatestHeading"]}>
            {latestOwnDoujinshi.map((item) => (
              <ArtworkCard
                href={toDoujinshiHref(item.slug)}
                title={item.data.title}
                image={item.data.packageImage}
                aspect="4/3"
                fit="contain"
                slug={toSlug(item.slug)}
              />
            ))}
          </Rail>
        )}

        {(recommendOwnDoujinshi.length > 0 || fanzaAffiliateItems.length > 0) && (
          <Rail title={t["home.recommendHeading"]} seeMoreHref="/doujinshi" seeMoreLabel={t["home.recommendHeading"]}>
            {recommendOwnDoujinshi.map((item) => (
              <ArtworkCard
                href={toDoujinshiHref(item.slug)}
                title={item.data.title}
                image={item.data.packageImage}
                aspect="4/3"
                fit="contain"
                slug={toSlug(item.slug)}
              />
            ))}
            {fanzaAffiliateItems.map((item) => (
              <a class="artwork-card affiliate-card" href={item.affiliateUrl} target="_blank" rel="noopener noreferrer sponsored">
                <div class="thumb">
                  <img src={item.imageUrl} alt={item.title[lang]} loading="lazy" />
                  <span class="affiliate-label">PR</span>
                </div>
                <p class="card-title">{item.title[lang]}</p>
              </a>
            ))}
          </Rail>
        )}

        {otherDoujinshiReviews.length > 0 && (
          <Rail title={t["home.doujinshiReviewHeading"]}>
            {otherDoujinshiReviews.map((item) => (
              <ArtworkCard
                href={toDoujinshiHref(item.slug)}
                title={item.data.title}
                image={item.data.packageImage}
                aspect="4/3"
                fit="contain"
                slug={toSlug(item.slug)}
              />
            ))}
          </Rail>
        )}

        {categoryRails.map((rail) => (
          <Rail title={rail.label[lang]}>
            {rail.items.map((artwork) => (
              <ArtworkCard
                href={toHref(artwork.slug)}
                title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
                image={getHeaderImage(artwork)}
                slug={toSlug(artwork.slug)}
              />
            ))}
          </Rail>
        ))}

        <a class="promo-banner promo-banner-tools" href="/tools">
          <div class="promo-copy">
            <h2>{t["home.toolsHeading"]}</h2>
            <p>{t["home.toolsBody"]}</p>
            <span class="promo-cta">{t["home.toolsCta"]} <i class="ti ti-arrow-right" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="promo-banner promo-banner-discord" href={discordUrl} target="_blank" rel="noopener noreferrer">
          <i class="ti ti-brand-discord promo-glyph-icon" aria-hidden="true"></i>
          <div class="promo-copy">
            <h2>{t["discord.ctaLead"]}</h2>
            <p>{t["discord.ctaDetail"]}</p>
            <span class="promo-cta">{t["discord.ctaButton"]} <i class="ti ti-external-link" aria-hidden="true"></i></span>
          </div>
        </a>
      </div>
    </div>

    <aside class="sidebar-column">
      <SidebarSection title={t["home.ranking"]}>
        <div id="ranking-list" class="ranking-list"></div>
      </SidebarSection>

      {seriesList.length > 0 && (
        <SidebarSection title={t["home.worksListHeading"]}>
          <div class="series-list">
            {seriesList.map((series) => (
              <a class="series-list-item" href={`/gallery/series/${encodeURIComponent(toPathSafeSlug(series.name))}`}>
                <span class="series-list-name">{series.name}</span>
                <span class="series-list-count">{series.count}{t["home.seriesCountSuffix"]}</span>
              </a>
            ))}
          </div>
        </SidebarSection>
      )}
    </aside>
   </div>
  </div>

  <script is:inline type="application/json" id="artworks-index" set:html={JSON.stringify(searchIndex)} />
</BaseLayout>

<script>
  interface IndexEntry {
    slug: string;
    title: string;
    thumb: string;
    imageCount: number;
    characters: string[];
    series: string;
    keywords: string[];
  }

  const API_BASE = import.meta.env.PUBLIC_API_BASE as string | undefined;

  const indexScript = document.getElementById("artworks-index");
  const searchIndex: IndexEntry[] = indexScript ? JSON.parse(indexScript.textContent ?? "[]") : [];
  const indexBySlug = new Map(searchIndex.map((entry) => [entry.slug, entry]));

  function buildCard(entry: IndexEntry) {
    const a = document.createElement("a");
    a.className = "artwork-card";
    a.href = `/gallery/${entry.slug}`;
    a.innerHTML = `
      <div class="thumb">
        <img src="${entry.thumb}" alt="${entry.title}" loading="lazy" />
      </div>
      <p class="card-title">${entry.title} 全${entry.imageCount}枚</p>
    `;
    return a;
  }

  // 検索・タグ絞り込み
  const searchInput = document.getElementById("artwork-search") as HTMLInputElement | null;
  const railsView = document.getElementById("rails-view");
  const resultsGrid = document.getElementById("search-results");
  const emptyMessage = document.getElementById("search-empty");

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.trim().toLowerCase();

    if (!query) {
      railsView?.removeAttribute("hidden");
      resultsGrid?.setAttribute("hidden", "true");
      emptyMessage?.setAttribute("hidden", "true");
      return;
    }

    const matches = searchIndex.filter((entry) => {
      const haystack = [entry.title, entry.series, ...entry.characters, ...entry.keywords]
        .join(" ")
        .toLowerCase();
      return haystack.includes(query);
    });

    railsView?.setAttribute("hidden", "true");
    if (resultsGrid) {
      resultsGrid.innerHTML = "";
      matches.forEach((entry) => resultsGrid.append(buildCard(entry)));
      resultsGrid.removeAttribute("hidden");
    }
    if (emptyMessage) {
      emptyMessage.toggleAttribute("hidden", matches.length > 0);
    }
  });

  // いいねランキング（取得できない場合はセクションごと非表示のまま）
  async function loadRanking() {
    const rankingList = document.getElementById("ranking-list");
    const rankingSection = rankingList?.closest(".sidebar-section");
    if (!rankingList || !rankingSection || !API_BASE) return;

    try {
      const res = await fetch(`${API_BASE}/likes/ranking?limit=10`);
      const data = await res.json();
      const ranking: { slug: string; count: number }[] = data.ranking ?? [];
      const resolved = ranking
        .map((row) => ({ row, entry: indexBySlug.get(row.slug) }))
        .filter((item): item is { row: { slug: string; count: number }; entry: IndexEntry } =>
          Boolean(item.entry),
        );

      if (resolved.length === 0) return;

      resolved.forEach(({ row, entry }, index) => {
        const card = buildCard(entry);
        const badge = document.createElement("span");
        badge.className = "rank-badge";
        badge.textContent = String(index + 1);
        card.prepend(badge);
        const likeBadge = document.createElement("span");
        likeBadge.className = "like-badge";
        likeBadge.innerHTML = `<i class="ti ti-heart" aria-hidden="true"></i> ${row.count}`;
        card.querySelector(".thumb")?.append(likeBadge);
        rankingList.append(card);
      });
      rankingSection.removeAttribute("hidden");
    } catch {
      // ランキング取得失敗時はセクションを表示しない
    }
  }

  document.getElementById("ranking-list")?.closest(".sidebar-section")?.setAttribute("hidden", "true");
  loadRanking();
</script>

<style is:global>
  [hidden] {
    display: none !important;
  }

  .home {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 3rem;
  }

  .home-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }

  .main-column {
    display: grid;
    gap: 2.25rem;
    min-width: 0;
  }

  .sidebar-column {
    display: grid;
    gap: 1.75rem;
    min-width: 0;
    position: sticky;
    top: 96px;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 0.5px solid var(--border-strong);
    background: var(--bg-elevated);
  }

  .search-bar i {
    color: var(--text-muted);
    font-size: 18px;
  }

  .search-bar input {
    flex: 1;
    border: none;
    background: none;
    color: var(--text-primary);
    font-size: 0.95rem;
    outline: none;
  }

  .search-bar input::placeholder {
    color: var(--text-muted);
  }

  .search-empty {
    color: var(--text-muted);
    text-align: center;
    margin: 0;
  }

  .search-results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }

  .ranking-list,
  .series-list {
    display: grid;
    gap: 0.6rem;
    grid-column: 1 / -1;
  }

  .series-list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--bg-elevated-2);
    text-decoration: none;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }
  .series-list-item:hover { color: var(--text-primary); }

  .series-list-name {
    font-size: 0.85rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .series-list-count {
    font-size: 0.75rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .rails-view {
    display: grid;
    gap: 2.25rem;
  }

  .rank-badge {
    position: absolute;
    left: 6px;
    top: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 5px;
    border-radius: 999px;
    background: rgb(0 0 0 / 55%);
    color: var(--text-primary);
    font-size: 12px;
    font-weight: 600;
  }

  .affiliate-card .thumb {
    background: var(--bg-elevated-2);
  }

  .affiliate-label {
    position: absolute;
    left: 6px;
    top: 6px;
    background: var(--accent);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .promo-banner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 0.5px solid var(--border-subtle);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .promo-banner:hover,
  .promo-banner:focus-visible {
    border-color: var(--accent-strong);
  }

  .promo-glyph {
    width: 96px;
    height: 72px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .promo-copy h2 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .promo-copy p {
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .promo-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .promo-banner-membership {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .promo-banner-discord {
    background: #4b5ac4;
    border-color: #4b5ac4;
  }

  .promo-banner-discord .promo-copy h2,
  .promo-banner-discord .promo-cta {
    color: #fff;
  }

  .promo-banner-discord .promo-copy p {
    color: rgb(255 255 255 / 85%);
  }

  .promo-glyph-icon {
    font-size: 40px;
    color: #fff;
    flex-shrink: 0;
  }

  @media (max-width: 960px) {
    .home-grid { grid-template-columns: 1fr; }
    .sidebar-column { position: static; }
  }

  @media (width <= 768px) {
    .home {
      padding: 1rem 1rem 2rem;
      gap: 1.75rem;
    }

    .promo-banner {
      flex-direction: column;
      align-items: flex-start;
    }

    .promo-glyph {
      width: 100%;
      height: 120px;
    }
  }
</style>
