---
import { getImage, Image } from "astro:assets";
import { getCollection } from "astro:content";
import AffiliateColumn from "~/components/AffiliateColumn.astro";
import ArtworkCard from "~/components/ArtworkCard.astro";
import Rail from "~/components/Rail.astro";
import SidebarSection from "~/components/SidebarSection.astro";
import { categories } from "~/constants/categories";
import { discordUrl, patreonUrl } from "~/constants/social";
import { ui } from "~/i18n/ui";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  formatImageCountLabel,
  getHeaderImage,
  getTotalImageCount,
} from "~/utils/artwork";
import { toPathSafeSlug } from "~/utils/slug";

const lang = "ja";
const t = ui[lang];

const artworks = await getCollection("artworks", ({ id }) =>
  id.startsWith(`${lang}/`),
);
const doujinshiList = await getCollection("doujinshi", ({ id }) =>
  id.startsWith(`${lang}/`),
);

function toSlug(fullSlug: string) {
  return fullSlug.replace(`${lang}/`, "");
}

function toHref(fullSlug: string) {
  return `/gallery/${toSlug(fullSlug)}`;
}

function toDoujinshiHref(fullSlug: string) {
  return `/doujinshi/${toSlug(fullSlug)}`;
}

const sortedByDate = [...artworks].sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const NEW_BADGE_WINDOW_MS = 7 * 24 * 60 * 60 * 1000;
const now = Date.now();
function isRecentlyPublished(item: { data: { publishDate: Date } }) {
  return now - item.data.publishDate.valueOf() <= NEW_BADGE_WINDOW_MS;
}

// 最新の1件はページ最上部に大きくフィーチャーするため、通常のレールからは除外する
const featuredArtwork = sortedByDate[0];
const latestArtworks = sortedByDate.slice(1, 13);

const categoryRails = categories
  .map((category) => ({
    ...category,
    items: sortedByDate.filter(category.match).slice(0, 12),
  }))
  .filter((rail) => rail.items.length > 0);

const recommendArtworks = sortedByDate.slice(0, 3);

// 自作の同人誌(isOwnWork!==false)と、他者作品のレビュー記事(isOwnWork===false)を分離
const ownDoujinshi = [...doujinshiList]
  .filter((d) => d.data.isOwnWork !== false)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const otherDoujinshiReviews = [...doujinshiList]
  .filter((d) => d.data.isOwnWork === false)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 12);
const latestOwnDoujinshi = ownDoujinshi.slice(0, 12);
const recommendOwnDoujinshi = ownDoujinshi.slice(0, 3);

// 作品別セクション: シリーズごとの件数と最新作をまとめる
const seriesMap = new Map<
  string,
  { count: number; latest: (typeof sortedByDate)[number] }
>();
for (const artwork of sortedByDate) {
  const series = artwork.data.series;
  if (!series) continue;
  const existing = seriesMap.get(series);
  if (existing) {
    existing.count += 1;
  } else {
    seriesMap.set(series, { count: 1, latest: artwork });
  }
}
const seriesList = await Promise.all(
  [...seriesMap.entries()]
    .map(([name, data]) => ({ name, count: data.count, latest: data.latest }))
    .sort((a, b) => b.count - a.count)
    .slice(0, 12)
    .map(async (series) => {
      const optimized = await getImage({
        src: getHeaderImage(series.latest),
        width: 400,
        format: "webp",
      });
      return { name: series.name, count: series.count, thumb: optimized.src };
    }),
);

// クライアント側の検索・いいねランキング表示用に、全作品の軽量インデックスを埋め込む
const searchIndex = await Promise.all(
  artworks.map(async (artwork) => {
    const optimized = await getImage({
      src: getHeaderImage(artwork),
      width: 480,
      format: "webp",
    });
    return {
      slug: toSlug(artwork.slug),
      title: artwork.data.title,
      thumb: optimized.src,
      imageCount: getTotalImageCount(artwork),
      characters: [
        artwork.data.main_character,
        ...(artwork.data.sub_characters ?? []),
      ].filter(Boolean),
      series: artwork.data.series,
      keywords: artwork.data.keywords ?? [],
    };
  }),
);

// いいねランキング解決用。LikeButtonのslug形式（作品=素のslug、同人誌="doujinshi-"接頭辞）に合わせて
// アートワークと同人誌の両方を1つのインデックスにまとめる
const rankingIndex = [
  ...searchIndex.map((entry) => ({
    slug: entry.slug,
    title: entry.title,
    thumb: entry.thumb,
    href: toHref(entry.slug),
  })),
  ...(await Promise.all(
    ownDoujinshi.map(async (item) => {
      const optimized = await getImage({
        src: item.data.packageImage,
        width: 480,
        format: "webp",
      });
      return {
        slug: `doujinshi-${toSlug(item.slug)}`,
        title: item.data.title,
        thumb: optimized.src,
        href: toDoujinshiHref(item.slug),
      };
    }),
  )),
];
---
<BaseLayout>
  <div class="home">
   <div class="home-grid">
    <AffiliateColumn lang={lang} />

    <div class="main-column">
      <div class="search-bar">
        <i class="ti ti-search" aria-hidden="true"></i>
        <input type="search" id="artwork-search" placeholder={t["home.searchPlaceholder"]} />
      </div>

      <p class="search-empty" id="search-empty" hidden>{t["home.noResults"]}</p>
      <div class="search-results-grid" id="search-results" hidden></div>

      <div id="rails-view" class="rails-view">
        {featuredArtwork && (
          <div class="featured-post">
            <div class="featured-thumb">
              <Image src={getHeaderImage(featuredArtwork)} alt={featuredArtwork.data.title} format="webp" width={480} loading="eager" />
              {isRecentlyPublished(featuredArtwork) && <span class="new-badge">NEW</span>}
            </div>
            <div class="featured-body">
              <h2 class="featured-title">{featuredArtwork.data.title}</h2>
              <p class="featured-excerpt">{featuredArtwork.data.description}</p>
              <a class="featured-cta" href={toHref(featuredArtwork.slug)}>{t["home.readArticle"]} <i class="ti ti-arrow-right" aria-hidden="true"></i></a>
            </div>
          </div>
        )}

        <Rail title={t["home.latest"]}>
          {latestArtworks.map((artwork, index) => (
            <ArtworkCard
              href={toHref(artwork.slug)}
              title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
              image={getHeaderImage(artwork)}
              slug={toSlug(artwork.slug)}
              thumbWidth={260}
              isNew={isRecentlyPublished(artwork)}
              eager={index < 4}
            />
          ))}
        </Rail>

        <Rail title={t["home.recommendHeading"]} seeMoreHref="/recommend" seeMoreLabel={t["home.recommendHeading"]}>
          {recommendArtworks.map((artwork) => (
            <ArtworkCard
              href={toHref(artwork.slug)}
              title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
              image={getHeaderImage(artwork)}
              slug={toSlug(artwork.slug)}
              thumbWidth={260}
              isNew={isRecentlyPublished(artwork)}
            />
          ))}
        </Rail>

        <a class="promo-banner promo-banner-membership" href={patreonUrl} target="_blank" rel="noopener noreferrer">
          <div class="promo-copy">
            <h2>{t["home.membershipHeading"]}</h2>
            <p>{t["home.membershipBody"]}</p>
            <span class="promo-cta">{t["home.membershipCta"]} <i class="ti ti-external-link" aria-hidden="true"></i></span>
          </div>
        </a>

        {latestOwnDoujinshi.length > 0 && (
          <Rail title={t["home.doujinshiLatestHeading"]} seeMoreHref="/doujinshi" seeMoreLabel={t["home.doujinshiLatestHeading"]}>
            {latestOwnDoujinshi.map((item) => (
              <ArtworkCard
                href={toDoujinshiHref(item.slug)}
                title={item.data.title}
                image={item.data.packageImage}
                aspect="4/3"
                fit="contain"
                thumbWidth={260}
                isNew={isRecentlyPublished(item)}
                slug={toSlug(item.slug)}
              />
            ))}
          </Rail>
        )}

        {recommendOwnDoujinshi.length > 0 && (
          <Rail title={t["home.recommendHeading"]} seeMoreHref="/doujinshi" seeMoreLabel={t["home.recommendHeading"]}>
            {recommendOwnDoujinshi.map((item) => (
              <ArtworkCard
                href={toDoujinshiHref(item.slug)}
                title={item.data.title}
                image={item.data.packageImage}
                aspect="4/3"
                fit="contain"
                thumbWidth={260}
                isNew={isRecentlyPublished(item)}
                slug={toSlug(item.slug)}
              />
            ))}
          </Rail>
        )}

        {otherDoujinshiReviews.length > 0 && (
          <Rail title={t["home.doujinshiReviewHeading"]}>
            {otherDoujinshiReviews.map((item) => (
              <ArtworkCard
                href={toDoujinshiHref(item.slug)}
                title={item.data.title}
                image={item.data.packageImage}
                aspect="4/3"
                fit="contain"
                thumbWidth={260}
                isNew={isRecentlyPublished(item)}
                slug={toSlug(item.slug)}
              />
            ))}
          </Rail>
        )}

        {categoryRails.map((rail) => (
          <Rail title={rail.label[lang]}>
            {rail.items.map((artwork) => (
              <ArtworkCard
                href={toHref(artwork.slug)}
                title={`${artwork.data.title}${formatImageCountLabel(getTotalImageCount(artwork), lang)}`}
                image={getHeaderImage(artwork)}
                slug={toSlug(artwork.slug)}
                thumbWidth={260}
                isNew={isRecentlyPublished(artwork)}
              />
            ))}
          </Rail>
        ))}

        <a class="promo-banner promo-banner-tools" href="/tools">
          <div class="promo-copy">
            <h2>{t["home.toolsHeading"]}</h2>
            <p>{t["home.toolsBody"]}</p>
            <span class="promo-cta">{t["home.toolsCta"]} <i class="ti ti-arrow-right" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="promo-banner promo-banner-discord" href={discordUrl} target="_blank" rel="noopener noreferrer">
          <i class="ti ti-brand-discord promo-glyph-icon" aria-hidden="true"></i>
          <div class="promo-copy">
            <h2>{t["discord.ctaLead"]}</h2>
            <p>{t["discord.ctaDetail"]}</p>
            <span class="promo-cta">{t["discord.ctaButton"]} <i class="ti ti-external-link" aria-hidden="true"></i></span>
          </div>
        </a>
      </div>
    </div>

    <aside class="sidebar-column sidebar-column-right">
      <SidebarSection title={t["home.ranking"]}>
        <div class="ranking-tabs" role="tablist">
          <button type="button" class="ranking-tab" data-period="daily" aria-selected="true">{t["home.rankingDaily"]}</button>
          <button type="button" class="ranking-tab" data-period="monthly" aria-selected="false">{t["home.rankingMonthly"]}</button>
          <button type="button" class="ranking-tab" data-period="yearly" aria-selected="false">{t["home.rankingYearly"]}</button>
        </div>
        <div id="ranking-list" class="ranking-list" data-empty-text={t["home.rankingEmpty"]}></div>
      </SidebarSection>

      {seriesList.length > 0 && (
        <SidebarSection title={t["home.worksListHeading"]}>
          <div class="series-list">
            {seriesList.map((series) => (
              <a class="series-list-item" href={`/gallery/series/${encodeURIComponent(toPathSafeSlug(series.name))}`}>
                <img class="series-list-thumb" src={series.thumb} alt="" loading="lazy" />
                <div class="series-list-fade"></div>
                <div class="series-list-text">
                  <span class="series-list-name">{series.name}</span>
                  <span class="series-list-count">{series.count}{t["home.seriesCountSuffix"]}</span>
                </div>
              </a>
            ))}
          </div>
        </SidebarSection>
      )}
    </aside>
   </div>
  </div>

  <script is:inline type="application/json" id="artworks-index" set:html={JSON.stringify(searchIndex)} />
  <script is:inline type="application/json" id="ranking-index" set:html={JSON.stringify(rankingIndex)} />
</BaseLayout>

<script>
  interface IndexEntry {
    slug: string;
    title: string;
    thumb: string;
    imageCount: number;
    characters: string[];
    series: string;
    keywords: string[];
  }

  const API_BASE = import.meta.env.PUBLIC_API_BASE as string | undefined;

  interface RankingEntry {
    slug: string;
    title: string;
    thumb: string;
    href: string;
  }

  const indexScript = document.getElementById("artworks-index");
  const searchIndex: IndexEntry[] = indexScript ? JSON.parse(indexScript.textContent ?? "[]") : [];

  const rankingIndexScript = document.getElementById("ranking-index");
  const rankingIndex: RankingEntry[] = rankingIndexScript
    ? JSON.parse(rankingIndexScript.textContent ?? "[]")
    : [];
  const rankingIndexBySlug = new Map(rankingIndex.map((entry) => [entry.slug, entry]));

  function buildCard(entry: IndexEntry) {
    const a = document.createElement("a");
    a.className = "artwork-card";
    a.href = `/gallery/${entry.slug}`;
    a.innerHTML = `
      <div class="thumb">
        <img src="${entry.thumb}" alt="${entry.title}" loading="lazy" />
      </div>
      <p class="card-title">${entry.title} 全${entry.imageCount}枚</p>
    `;
    return a;
  }

  function buildRankingCard(entry: RankingEntry) {
    const a = document.createElement("a");
    a.className = "artwork-card";
    a.href = entry.href;
    a.innerHTML = `
      <div class="thumb">
        <img src="${entry.thumb}" alt="${entry.title}" loading="lazy" />
      </div>
      <p class="card-title">${entry.title}</p>
    `;
    return a;
  }

  // 検索・タグ絞り込み
  const searchInput = document.getElementById("artwork-search") as HTMLInputElement | null;
  const railsView = document.getElementById("rails-view");
  const resultsGrid = document.getElementById("search-results");
  const emptyMessage = document.getElementById("search-empty");

  searchInput?.addEventListener("input", () => {
    const query = searchInput.value.trim().toLowerCase();

    if (!query) {
      railsView?.removeAttribute("hidden");
      resultsGrid?.setAttribute("hidden", "true");
      emptyMessage?.setAttribute("hidden", "true");
      return;
    }

    const matches = searchIndex.filter((entry) => {
      const haystack = [entry.title, entry.series, ...entry.characters, ...entry.keywords]
        .join(" ")
        .toLowerCase();
      return haystack.includes(query);
    });

    railsView?.setAttribute("hidden", "true");
    if (resultsGrid) {
      resultsGrid.innerHTML = "";
      matches.forEach((entry) => resultsGrid.append(buildCard(entry)));
      resultsGrid.removeAttribute("hidden");
    }
    if (emptyMessage) {
      emptyMessage.toggleAttribute("hidden", matches.length > 0);
    }
  });

  // いいねランキング（デイリー/マンスリー/年間）。取得できない場合はセクションごと非表示のまま
  const RANKING_PERIODS = ["daily", "monthly", "yearly"] as const;
  type RankingPeriod = (typeof RANKING_PERIODS)[number];
  type RankingRow = { slug: string; count: number };

  const rankingCache = new Map<RankingPeriod, RankingRow[]>();

  function renderRankingPeriod(period: RankingPeriod) {
    const rankingList = document.getElementById("ranking-list");
    if (!rankingList) return;

    rankingList.innerHTML = "";
    const rows = rankingCache.get(period) ?? [];
    const resolved = rows
      .map((row) => ({ row, entry: rankingIndexBySlug.get(row.slug) }))
      .filter((item): item is { row: RankingRow; entry: RankingEntry } => Boolean(item.entry));

    if (resolved.length === 0) {
      const empty = document.createElement("p");
      empty.className = "ranking-empty";
      empty.textContent = rankingList.dataset.emptyText ?? "";
      rankingList.append(empty);
      return;
    }

    resolved.forEach(({ row, entry }, index) => {
      const card = buildRankingCard(entry);
      const badge = document.createElement("span");
      badge.className = "rank-badge";
      badge.textContent = String(index + 1);
      card.prepend(badge);
      const likeBadge = document.createElement("span");
      likeBadge.className = "like-badge";
      likeBadge.innerHTML = `<i class="ti ti-heart" aria-hidden="true"></i> ${row.count}`;
      card.querySelector(".thumb")?.append(likeBadge);
      rankingList.append(card);
    });
  }

  async function loadRanking() {
    const rankingList = document.getElementById("ranking-list");
    const rankingSection = rankingList?.closest(".sidebar-section");
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".ranking-tab"));
    if (!rankingList || !rankingSection || !API_BASE) return;

    try {
      const responses = await Promise.all(
        RANKING_PERIODS.map((period) =>
          fetch(`${API_BASE}/likes/ranking?period=${period}&limit=10`)
            .then((res) => res.json())
            .then((data) => (data.ranking ?? []) as RankingRow[]),
        ),
      );

      let hasAnyData = false;
      RANKING_PERIODS.forEach((period, i) => {
        rankingCache.set(period, responses[i]);
        if (responses[i].some((row) => rankingIndexBySlug.has(row.slug))) {
          hasAnyData = true;
        }
      });

      if (!hasAnyData) return;

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((other) => other.setAttribute("aria-selected", "false"));
          tab.setAttribute("aria-selected", "true");
          renderRankingPeriod(tab.dataset.period as RankingPeriod);
        });
      });

      renderRankingPeriod("daily");
      rankingSection.removeAttribute("hidden");
    } catch {
      // ランキング取得失敗時はセクションを表示しない
    }
  }

  document.getElementById("ranking-list")?.closest(".sidebar-section")?.setAttribute("hidden", "true");
  loadRanking();
</script>

<style is:global>
  [hidden] {
    display: none !important;
  }

  .home {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 3rem;
  }

  .home-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }

  .main-column {
    display: grid;
    gap: 2.25rem;
    min-width: 0;
  }

  .sidebar-column {
    display: grid;
    gap: 1.75rem;
    min-width: 0;
    position: sticky;
    top: 96px;
  }

  /* 左のアフィリエイト欄は、メインコンテンツ幅を圧迫しない十分な余白がある画面幅でのみ表示する */
  .sidebar-column-left {
    display: none;
  }

  @media (min-width: 1480px) {
    .home {
      max-width: 1520px;
    }
    .home-grid {
      grid-template-columns: 280px 1fr 300px;
    }
    .sidebar-column-left {
      display: grid;
    }
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 0.5px solid var(--border-strong);
    background: var(--bg-elevated);
  }

  .search-bar i {
    color: var(--text-muted);
    font-size: 18px;
  }

  .search-bar input {
    flex: 1;
    border: none;
    background: none;
    color: var(--text-primary);
    font-size: 0.95rem;
    outline: none;
  }

  .search-bar input::placeholder {
    color: var(--text-muted);
  }

  .search-empty {
    color: var(--text-muted);
    text-align: center;
    margin: 0;
  }

  .search-results-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }

  .ranking-list,
  .series-list {
    display: grid;
    gap: 0.6rem;
    grid-column: 1 / -1;
  }

  .ranking-tabs {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .ranking-tab {
    flex: 1;
    padding: 0.4rem 0.5rem;
    border: 0.5px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated-2);
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .ranking-tab:hover {
    color: var(--text-primary);
  }

  .ranking-tab[aria-selected="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .ranking-empty {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .series-list-item {
    position: relative;
    display: flex;
    align-items: center;
    height: 92px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-elevated-2);
    text-decoration: none;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }
  .series-list-item:hover { color: var(--text-primary); }

  .series-list-thumb {
    position: absolute;
    inset: 0 0 0 auto;
    width: 70%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .series-list-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--bg-elevated-2) 0%, var(--bg-elevated-2) 32%, transparent 92%);
    z-index: 1;
  }

  .series-list-text {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.25rem;
    padding: 0 1rem;
    min-width: 0;
  }

  .series-list-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 11rem;
  }

  .series-list-count {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .rails-view {
    display: grid;
    gap: 2.25rem;
  }

  .featured-post {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 0.5px solid var(--border-subtle);
  }

  .featured-thumb {
    position: relative;
    flex: 0 0 auto;
    width: 320px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-elevated-2);
  }
  .featured-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .featured-body {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
  }

  .featured-title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .featured-excerpt {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
