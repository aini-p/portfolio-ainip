---
import smartypants from "smartypants";
import DiscordFloat from "~/components/DiscordFloat.astro";
import Header from "~/components/header.astro";
import MobileStickyAd from "~/components/MobileStickyAd.astro";
import { adsense, resolveAdNetwork } from "~/constants/ads";
import { profileNames, siteCopyrightLabel } from "~/constants/social";

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: {
    src: string;
    alt: string;
  };
  // 会員登録LPなど、コンバージョンを最優先したいページで広告を一切出さないためのフラグ
  noAds?: boolean;
}

const { title, description, keywords, image, noAds = false } = Astro.props;
const { lang } = Astro.locals; // ミドルウェアから取得
const adNetwork = resolveAdNetwork(lang);

// meta description/og:description/twitter:descriptionは属性値に生の改行が入ると
// 一部のSNSカードクローラー(X等)がタグをパースできず、以降のog:imageなども読めなくなることがあるため、
// 1行に潰してから出力する(ページ本文の改行表示には影響しない)
const metaDescription = description?.replace(/\s*\n+\s*/g, " ").trim();
const defaultSocialImage = {
  src: "/images/profile-share-card.png",
  alt:
    lang === "ja" ? "あと5分。ポートフォリオサイト" : "At5Fun portfolio site",
};
const socialImage = image ?? defaultSocialImage;

// ▼▼▼ hreflang用のパス生成ロジックを修正 ▼▼▼
const currentPath = Astro.url.pathname;
let jaPath: string, enPath: string;

if (lang === "en") {
  // 現在英語ページ (/en/foo)
  jaPath = currentPath.replace(/^\/en/, "") || "/"; // /en を削除、空なら /
  enPath = currentPath;
} else {
  // 現在日本語ページ (/foo)
  jaPath = currentPath;
  enPath = `/en${currentPath === "/" ? "" : currentPath}`; // /en を先頭に追加 (ルートの場合は /en)
}
// ルートパスの場合、末尾のスラッシュを保証 (SEO的に推奨)
if (jaPath === "") jaPath = "/";
if (enPath === "/en") enPath = "/en/";
// ▲▲▲ ここまで ▲▲▲

const siteName = profileNames[lang];
const pageTitle = title ? `${title} · ${siteName}` : siteName;
---

<html lang={lang}>
  <head>
    {/* ... (metaタグなどは変更なし) ... */}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* ▼▼▼ canonical URL を修正 ▼▼▼ */}
    <link rel="canonical" href={new URL(lang === 'ja' ? jaPath : enPath, Astro.site)} />
    {/* ▲▲▲ ここまで ▲▲▲ */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="msapplication-square70x70logo" content="/site-tile-70x70.png">
    <meta name="msapplication-square150x150logo" content="/site-tile-150x150.png">
    <meta name="msapplication-wide310x150logo" content="/site-tile-310x150.png">
    <meta name="msapplication-square310x310logo" content="/site-tile-310x310.png">
    <meta name="msapplication-TileColor" content="#0078d7">
    <link rel="shortcut icon" type="image/vnd.microsoft.icon" href="/favicon.ico">
    <link rel="icon" type="image/vnd.microsoft.icon" href="/favicon.ico">
    <link rel="apple-touch-icon" sizes="57x57" href="/apple-touch-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/apple-touch-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/apple-touch-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-touch-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/apple-touch-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/apple-touch-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="36x36" href="/android-chrome-36x36.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/android-chrome-48x48.png">
    <link rel="icon" type="image/png" sizes="72x72" href="/android-chrome-72x72.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/android-chrome-96x96.png">
    <link rel="icon" type="image/png" sizes="128x128" href="/android-chrome-128x128.png">
    <link rel="icon" type="image/png" sizes="144x144" href="/android-chrome-144x144.png">
    <link rel="icon" type="image/png" sizes="152x152" href="/android-chrome-152x152.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="256x256" href="/android-chrome-256x256.png">
    <link rel="icon" type="image/png" sizes="384x384" href="/android-chrome-384x384.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">
    <link rel="icon" type="image/png" sizes="36x36" href="/icon-36x36.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/icon-48x48.png">
    <link rel="icon" type="image/png" sizes="72x72" href="/icon-72x72.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/icon-96x96.png">
    <link rel="icon" type="image/png" sizes="128x128" href="/icon-128x128.png">
    <link rel="icon" type="image/png" sizes="144x144" href="/icon-144x144.png">
    <link rel="icon" type="image/png" sizes="152x152" href="/icon-152x152.png">
    <link rel="icon" type="image/png" sizes="160x160" href="/icon-160x160.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192x192.png">
    <link rel="icon" type="image/png" sizes="196x196" href="/icon-196x196.png">
    <link rel="icon" type="image/png" sizes="256x256" href="/icon-256x256.png">
    <link rel="icon" type="image/png" sizes="384x384" href="/icon-384x384.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512x512.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16x16.png">
    <link rel="icon" type="image/png" sizes="24x24" href="/icon-24x24.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32x32.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#17141c" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/dist/tabler-icons.min.css" />

    {!noAds && adNetwork === "adsense" && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense.client}`}
        crossorigin="anonymous"
      ></script>
    )}

    {!noAds && adNetwork === "exoclick" && (
      <script is:inline async src="https://a.magsrv.com/ad-provider.js"></script>
    )}

    {/* ▼▼▼ hreflangのURLを修正 ▼▼▼ */}
    <link rel="alternate" hreflang="ja" href={new URL(jaPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(jaPath, Astro.site)} /> {/* デフォルトは日本語に */}
    {/* ▲▲▲ ここまで ▲▲▲ */}
    
    <title set:html={smartypants(pageTitle, 1)} />
    {/* ... (残りのheadタグは変更なし) ... */}
    {metaDescription && <meta name="description" content={smartypants(metaDescription, 1)} />}
    {keywords && <meta name="keywords" content={keywords} />}
    <meta property="og:title" content={smartypants(pageTitle, 1)} />
    <meta property="og:type" content="website" />
    {metaDescription && <meta property="og:description" content={smartypants(metaDescription, 1)} />}
    <meta property="og:url" content={new URL(lang === 'ja' ? jaPath : enPath, Astro.site)} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={new URL(socialImage.src, Astro.site).toString()} />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(socialImage.src, Astro.site).toString()} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
    <meta name="twitter:title" content={smartypants(pageTitle, 1)} />
    {metaDescription && <meta name="twitter:description" content={smartypants(metaDescription, 1)} />}

    {/* 本番環境 (npm run build) のみで実行する */}
    {import.meta.env.PROD && (
      <>
        <!-- Google tag (gtag.js) -->
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KQ97TC3ZQ3"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-KQ97TC3ZQ3');
        </script>
      </>
    )}

    {/* 収益に直結するCTA（メンバーシップ導線・購入リンク・いいね・ツール利用）のクリックをGA4イベントとして計測する。
        要素に data-ga-event="イベント名" を付け、他の data-ga-* 属性はそのままイベントパラメータとして送られる。
        本番以外はwindow.gtagが存在しないため何もしない */}
    <script is:inline>
      document.addEventListener('click', function (e) {
        if (typeof window.gtag !== 'function') return;
        var el = e.target.closest('[data-ga-event]');
        if (!el) return;
        var eventName = el.getAttribute('data-ga-event');
        var params = {};
        for (var i = 0; i < el.attributes.length; i++) {
          var attr = el.attributes[i];
          if (attr.name.indexOf('data-ga-') === 0 && attr.name !== 'data-ga-event') {
            var key = attr.name.slice('data-ga-'.length).replace(/-([a-z])/g, function (_, c) {
              return c.toUpperCase();
            });
            params[key] = attr.value;
          }
        }
        window.gtag('event', eventName, params);
      }, true);
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <footer>
      <small>&copy; {new Date().getFullYear()} {siteCopyrightLabel} All rights reserved.</small>
    </footer>
    <DiscordFloat lang={lang} />
    {!noAds && <MobileStickyAd lang={lang} />}
  </body>
</html>

<style is:global>
  /* ... (styleタグの中身は変更なし) ... */
  *, *::before, *::after { box-sizing: border-box; } * { margin: 0; }
  html {
    -webkit-text-size-adjust: 100%;
    overflow-y: scroll;
    scrollbar-gutter: stable;
  }
  body {
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    /* 画面が短くてもフッターが最下部に固定されるようにします */
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  img, picture, video, canvas, svg { display: block; max-width: 100%; }
  input, button, textarea, select { font: inherit; }
  p, h1, h2, h3, h4, h5, h6 { overflow-wrap: break-word; }
  :root {
    color-scheme: dark;
    --font: "Noto Sans JP", system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";

    --bg-page: #17141c;
    --bg-elevated: #1f1b27;
    --bg-elevated-2: #241e2e;
    --border-subtle: #2a2532;
    --border-strong: #362e44;

    --text-primary: #ede9f5;
    --text-secondary: #a79fc0;
    --text-muted: #6b6478;

    --accent: #7f4ab7;
    --accent-strong: #9b63d6;
    --accent-soft: #2a2036;
    --heart: #f0997b;
    --outline: var(--accent-strong);

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 20px;

    --space-xs: 0.5rem;
    --space-sm: 0.75rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
  }
  body {
    background-color: var(--bg-page);
    font-family: var(--font);
    font-weight: 300;
    color: var(--text-primary);
    letter-spacing: 0.05em;
  }
  h1, h2 { font-weight: 300; }
  main {
    padding-top: 80px;
    flex-grow: 1; /* メインコンテンツが残りのスペースをすべて埋める */
  }
  footer {
    width: 100%;
    padding: 2rem 1rem;
    font-size: 1.0rem;
    color: var(--text-muted);

    /* Flexboxで中央揃え */
    display: flex;
    justify-content: center;
  }

  /* モバイル下部固定広告バー(MobileStickyAd)の表示中は、フッターがその裏に隠れないよう
     余白を足す。バーが閉じられると html.has-mobile-sticky-ad が外れて元の余白に戻る */
  @media (width <= 768px) {
    html.has-mobile-sticky-ad footer {
      padding-bottom: calc(2rem + 72px);
    }
  }

  /* トップページと同じ左右サイドバー（HomeStyleSidebars.astro）を使う一覧・ハブ系ページ向けの
     共通グリッド。ページ側は外側を .sidebar-page-shell > .sidebar-page-grid で囲み、
     中に HomeStyleSidebars（左サイドバー＋中央<slot/>＋右サイドバー）を1回だけ配置する */
  .sidebar-page-shell {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 3rem;
  }

  .sidebar-page-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }

  .main-column {
    display: grid;
    gap: 2.25rem;
    min-width: 0;
  }

  .sidebar-column {
    display: grid;
    gap: 1.75rem;
    min-width: 0;
    position: sticky;
    top: 96px;
  }

  /* 左のアフィリエイト欄は、メインコンテンツ幅を圧迫しない十分な余白がある画面幅でのみ表示する */
  .sidebar-column-left {
    display: none;
  }

  @media (min-width: 1480px) {
    .sidebar-page-shell {
      max-width: 1540px;
    }
    .sidebar-page-grid {
      grid-template-columns: 300px 1fr 300px;
    }
    .sidebar-column-left {
      display: grid;
    }
  }

  @media (max-width: 960px) {
    .sidebar-page-grid { grid-template-columns: 1fr; }
    .sidebar-column { position: static; }
  }
</style>